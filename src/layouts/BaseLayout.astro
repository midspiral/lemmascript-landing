---
import '@fontsource/dm-sans/300.css'
import '@fontsource/dm-sans/400.css'
import '@fontsource/dm-sans/500.css'
import '@fontsource/dm-sans/600.css'
import '@fontsource/dm-sans/700.css'
import '@fontsource/dm-sans/800.css'
import '@fontsource/jetbrains-mono/400.css'
import '@fontsource/jetbrains-mono/600.css'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/components.css'
import Analytics from '../components/Analytics.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import ThemeToggle from '../components/ThemeToggle.astro'

interface Props {
  title: string
  description?: string
  image?: string
}

const {
  title,
  description = 'LemmaScript is TypeScript with syntax for contracts. Agents write code that is correct by construction; engineers review it at a glance. Zero runtime cost, works on existing code.',
  image = '/og.png',
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// Markdown mirror of this page (llms.txt convention): / -> /index.md, /install -> /install.md
const markdownURL = new URL(
  Astro.url.pathname === '/' ? '/index.md' : Astro.url.pathname.replace(/\/$/, '') + '.md',
  Astro.site,
)

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Midspiral',
      url: 'https://midspiral.com',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'LemmaScript',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows',
      url: 'https://lemmascript.org',
      description:
        'TypeScript with syntax for contracts — code that is correct by construction, written by agents and reviewable by engineers.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      softwareHelp: { '@type': 'CreativeWork', url: 'https://docs.lemmascript.org' },
      sameAs: [
        'https://github.com/midspiral/LemmaScript',
        'https://www.npmjs.com/package/lemmascript',
      ],
      author: { '@type': 'Organization', name: 'Midspiral', url: 'https://midspiral.com' },
    },
  ],
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <script is:inline>
      // Applied before first paint to avoid a flash. Light is the default;
      // dark is opt-in, remembered per visitor.
      (function () {
        var t = localStorage.getItem('theme')
        if (t !== 'dark') document.documentElement.setAttribute('data-theme', 'light')
      })()
    </script>
    <Analytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="text/markdown" href={markdownURL} />
    <meta name="description" content={description} />
    <meta name="keywords" content="LemmaScript, TypeScript contracts, correct by construction, code correctness, AI coding agents, Midspiral" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LemmaScript" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).href} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true"></div>
    <a href="#main" class="skip-nav">Skip to main content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ThemeToggle />
  </body>
</html>
