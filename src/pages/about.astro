---
import BaseLayout from '../layouts/BaseLayout.astro'

const principles = [
  { t: 'Guarantees, not guesswork', d: 'Software should be able to make guarantees about its own behavior. We build the tools that turn “it should be correct” into “it is — for every input.”' },
  { t: 'Meet developers where they are', d: 'Guaranteed correctness has lived in a separate, specialist world for decades. We bring it into plain TypeScript — no new language, no rewrite, no PhD required.' },
  { t: 'Built for the agent era', d: 'AI writes more code every day. A guarantee is the missing feedback loop that lets agents converge on correct code instead of confident guesses.' },
]

const timeline = [
  { when: 'The problem', what: 'AI-generated code ships faster than anyone can review it. For the logic that has to be right, even a strong test suite can’t promise it’s correct for every input.' },
  { when: 'The insight', what: 'There’s a way to guarantee code is correct for every input — but until now it meant leaving the language teams already use.' },
  { when: 'LemmaScript', what: 'A toolchain that guarantees ordinary TypeScript is correct — built from the ground up for engineers and AI agents working together.' },
]
---

<BaseLayout
  title="About — Midspiral"
  description="Midspiral builds the correctness layer for AI-generated software. LemmaScript guarantees ordinary TypeScript is correct — built for engineers and AI agents."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// about midspiral</span>
      <h1>The correctness layer for <em>AI-generated software</em>.</h1>
      <p class="lede">
        Midspiral is building the infrastructure that lets teams and autonomous agents guarantee their
        code is correct — not assume it. LemmaScript is our first product.
      </p>
    </div>
  </header>

  <!-- mission -->
  <section class="section">
    <div class="container narrow-prose">
      <span class="kicker">// the mission</span>
      <p class="big-statement">
        As more software is written by machines, the bottleneck shifts from <em>writing</em> code to
        <em>trusting</em> it. We think the answer isn’t more review — it’s guaranteed correctness, made
        accessible to every engineer and every agent.
      </p>
    </div>
  </section>

  <!-- why now -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// why now</span>
        <h2>From a problem to a guarantee</h2>
      </div>
      <div class="timeline">
        {timeline.map((t, i) => (
          <div class="tl-item">
            <span class="tl-n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{t.when}</h3>
              <p>{t.what}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- principles -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// principles</span>
        <h2>What we believe</h2>
      </div>
      <div class="prin-grid">
        {principles.map((p) => (
          <div class="prin">
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- cta -->
  <section class="section">
    <div class="container center">
      <div class="card about-cta">
        <span class="kicker">// get in touch</span>
        <h2>Building something that has to be right?</h2>
        <p class="section-desc" style="margin:var(--sp-3) auto var(--sp-8);max-width:46ch">We’d like to hear about it.</p>
        <div class="about-actions">
          <a href="https://midspiral.com" target="_blank" rel="noopener" class="btn btn-primary">Visit Midspiral →</a>
          <a href="https://github.com/midspiral/LemmaScript" target="_blank" rel="noopener" class="btn btn-secondary">View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow-prose { max-width: var(--container-narrow); }
  .big-statement { font-family: var(--font-display); font-size: var(--fs-h2); font-weight: 600; line-height: 1.4;
    color: var(--text-primary); letter-spacing: -0.01em; margin-top: var(--sp-4); }
  .big-statement em { font-style: normal; color: var(--accent); }

  .timeline { display: grid; gap: var(--sp-6); max-width: 720px; }
  .tl-item { display: grid; grid-template-columns: auto 1fr; gap: var(--sp-6); padding-bottom: var(--sp-6); border-bottom: 1px solid var(--border-subtle); }
  .tl-item:last-child { border-bottom: none; }
  .tl-n { font-family: var(--font-mono); font-size: var(--fs-h3); color: var(--accent-dim); }
  .tl-item h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-2); }
  .tl-item p { font-size: var(--fs-body); }

  .prin-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .prin { padding: var(--sp-6); border-left: 2px solid var(--accent-dim); }
  .prin h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-3); }
  .prin p { font-size: var(--fs-small); }

  .about-cta { padding: var(--sp-16); box-shadow: var(--elev-glow); }
  .about-cta h2 { font-size: var(--fs-h1); margin-top: var(--sp-3); }
  .about-actions { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .prin-grid { grid-template-columns: 1fr; }
    .tl-item { grid-template-columns: 1fr; gap: var(--sp-2); }
  }
</style>
