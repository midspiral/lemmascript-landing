---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { authorList, formatPostDate, sortPosts, type Post } from '../../lib/blog'
import '../../styles/blog.css'

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog', ({ data }) => data.published !== false))

  // Newest first, so "previous" is the next-older post.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }))
}

interface Props {
  post: Post
  newer: Post | null
  older: Post | null
}

const { post, newer, older } = Astro.props
const { Content } = await render(post)
---

<BaseLayout
  title={`${post.data.title} — LemmaScript`}
  description={post.data.description}
  image={post.data.image}
  article={{
    publishedDate: post.data.date.toISOString(),
    authors: post.data.authors,
    tags: post.data.tags,
  }}
>
  <div class="container">
    <a class="post-back" href="/blog/">← All posts</a>

    <div class="post-layout">
      <article>
        <header class="post-head">
          <span class="kicker">// post</span>
          <h1>{post.data.title}</h1>
          <div class="post-meta">
            <span>{authorList(post.data.authors)}</span>
            <span class="sep">·</span>
            <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
          </div>
        </header>

        <div class="prose">
          <Content />
        </div>

        <aside class="post-cta">
          <h2>Contracts on your own code</h2>
          <p>
            LemmaScript is TypeScript with syntax for contracts. Point it at an existing codebase —
            the agent writes the contract and iterates until the code is correct by construction.
          </p>
          <div class="post-cta-actions">
            <a class="btn btn-primary" href="/install">Install</a>
            <a class="btn btn-secondary" href="https://docs.lemmascript.org" target="_blank" rel="noopener">Read the docs</a>
          </div>
        </aside>

        {(newer || older) && (
          <nav class="post-nav" aria-label="More posts">
            {older && (
              <a class="post-nav-item" href={`/blog/${older.id}/`} rel="prev">
                <span class="post-nav-dir">← Previous</span>
                <span class="post-nav-title">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a class="post-nav-item is-next" href={`/blog/${newer.id}/`} rel="next">
                <span class="post-nav-dir">Next →</span>
                <span class="post-nav-title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )}
      </article>
    </div>
  </div>

  <script is:inline>
    // Astro gives headings ids; this adds the click-to-copy-link affordance on
    // top, so the markdown stays plain and no rehype plugin is needed.
    document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((h) => {
      const a = document.createElement('a')
      a.className = 'anchor'
      a.href = '#' + h.id
      a.textContent = '#'
      a.setAttribute('aria-label', 'Link to this section')
      h.prepend(a)
    })
  </script>
</BaseLayout>
