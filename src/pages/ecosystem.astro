---
import BaseLayout from '../layouts/BaseLayout.astro'

// status: 'available' | 'preview' | 'planned'
const label = { available: 'Available', preview: 'Tech preview', planned: 'Planned' }
const badgeClass = { available: 'badge-verified', preview: 'badge-info', planned: 'badge-pending' }

const items = [
  {
    name: 'claimcheck',
    tag: 'toolchain',
    status: 'available',
    desc: 'Makes sure your contracts say what you meant. A contract can be internally consistent and still guarantee something other than what you intended — claimcheck cross-examines the plain-English //@ contract against the formal clauses and surfaces those gaps, so you can trust not just that the code is correct, but that it’s correct for the right reasons.',
  },
  {
    name: 'sepui',
    tag: 'toolchain',
    status: 'preview', // [TODO] confirm status
    desc: '[TODO] one-paragraph description of what sepui does and why it matters.',
  },
  {
    name: 'runtime-guard',
    tag: 'toolchain',
    status: 'available',
    desc: 'Turns a contract-checked module into a drop-in that enforces its own //@ requires at runtime. Call it out-of-contract and you get a loud, debuggable error instead of a wrong answer — so you delete your hand-written guards.',
  },
  {
    name: 'VS Code extension',
    tag: 'editor',
    status: 'preview',
    desc: 'Inline correctness status in the gutter — green when the contract holds, red with the exact input that breaks it. Contract autocomplete for //@ requires and //@ ensures, so you write them fast and get them right.',
  },
  {
    name: 'CI',
    tag: 'pipeline',
    status: 'available',
    desc: 'Enforce correctness on every pull request — a GitHub Action that fails the build on any unmet contract, so nothing merges unless every guarantee holds.',
  },
  {
    name: 'Skills',
    tag: 'agents',
    status: 'available',
    desc: 'Drop-in skills that teach a coding agent to drive LemmaScript — when to add a contract, how to read the result, and how to iterate until the code is correct. Install once; the agent closes its own generate → check → fix loop without prompting.',
  },
  {
    name: 'CLI',
    tag: 'toolchain',
    status: 'available',
    desc: 'lemmascript check runs anywhere a shell does — local pre-commit hooks, scripts, or any CI system. The same loop your agent drives, available at your fingertips.',
  },
]
---

<BaseLayout
  title="Ecosystem — LemmaScript"
  description="Everything that snaps onto the LemmaScript core: claimcheck, sepui, runtime-guard, the VS Code extension, CI enforcement, agent skills, and the CLI."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// ecosystem</span>
      <h1>Everything that snaps onto the <em>core</em>.</h1>
      <p class="lede">
        The <code class="inline">lsc</code> compiler is the free, open core. Around it sits a growing ecosystem —
        tools that extend the toolchain, an extension that brings it into your editor, enforcement for your
        pipeline, and skills that equip your agents.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="eco-grid">
        {items.map((it) => (
          <div class="card eco-card">
            <div class="eco-top">
              <h3>{it.name}</h3>
              <span class={`badge ${badgeClass[it.status]}`}><span class="bdot"></span>{label[it.status]}</span>
            </div>
            <span class="eco-tag">// {it.tag}</span>
            <p>{it.desc}</p>
          </div>
        ))}
      </div>

      <div class="callout callout-warn" style="margin-top:var(--sp-12)">
        <span class="mark">!</span>
        <div><b>Tech preview.</b> The ecosystem is still stabilizing. Status labels above reflect current availability and will move toward <b style="color:var(--state-verified)">Available</b> as the preview matures.</div>
      </div>

      <div class="center" style="margin-top:var(--sp-12)">
        <a href="https://docs.lemmascript.com" target="_blank" rel="noopener" class="btn btn-primary">Ecosystem docs →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eco-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
  .eco-card { display: flex; flex-direction: column; gap: var(--sp-2); }
  .eco-top { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); }
  .eco-card h3 { font-size: var(--fs-h3); }
  .eco-tag {
    font-family: var(--font-mono); font-size: var(--fs-caption);
    letter-spacing: 0.06em; color: var(--text-faint);
  }
  .eco-card p { font-size: var(--fs-small); color: var(--text-secondary); margin-top: var(--sp-1); }

  .inline {
    font-family: var(--font-mono); font-size: 0.9em;
    color: var(--accent-bright); background: var(--state-verified-bg);
    padding: 1px 5px; border-radius: var(--r-sm);
  }

  @media (max-width: 860px) {
    .eco-grid { grid-template-columns: 1fr; }
  }
</style>
