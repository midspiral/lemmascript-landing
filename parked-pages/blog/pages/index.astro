---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatPostDate, sortPosts } from '../../lib/blog'
import '../../styles/blog.css'

const posts = sortPosts(await getCollection('blog', ({ data }) => data.published !== false))
---

<BaseLayout
  title="Blog — LemmaScript"
  description="Notes from the team building LemmaScript: how contracts hold up in real TypeScript codebases, what agents do with them, and what we learn from shipping."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// blog</span>
      <h1>Dev notes</h1>
      <p class="lede">
        Notes from the team building LemmaScript: how contracts hold up in real TypeScript codebases, what agents do with them, and what we learn from shipping.
      </p>
    </div>
  </header>

  <section class="container section" style="padding-block: var(--sp-12) var(--sp-24);">
    {posts.length === 0 ? (
      <p class="blog-empty">Nothing published yet. First post is on its way.</p>
    ) : (
      <ol class="blog-list">
        {posts.map((post) => (
          <li class="blog-row">
            <a class="blog-link" href={`/blog/${post.id}/`}>
              <time class="blog-row-date" datetime={post.data.date.toISOString()}>
                {formatPostDate(post.data.date)}
              </time>
              <div>
                <h2 class="blog-row-title">{post.data.title}</h2>
                <p class="blog-row-desc">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="blog-row-tags">
                    {post.data.tags.map((t) => <span class="blog-tag">{`// ${t}`}</span>)}
                  </div>
                )}
              </div>
            </a>
          </li>
        ))}
      </ol>
    )}

    <p style="margin-top: var(--sp-10);">
      <a class="blog-feed" href="/blog/rss.xml">
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M3 3v2.5a7.5 7.5 0 0 1 7.5 7.5H13A10 10 0 0 0 3 3Zm0 4.5V10a3 3 0 0 1 3 3h2.5A5.5 5.5 0 0 0 3 7.5ZM4.5 11a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"/></svg>
        RSS feed
      </a>
    </p>
  </section>
</BaseLayout>
