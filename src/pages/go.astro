---
// lemmascript.org/go — the page behind the sticker QR code.
// One job: get the prompt onto the reader's clipboard in one tap.
import BaseLayout from '../layouts/BaseLayout.astro'
import { AGENT_PROMPT } from '../lib/agentPrompt'
---

<BaseLayout
  title="Start using LemmaScript — one paste"
  description="Paste one prompt into your coding agent. It installs LemmaScript, learns the skills, and writes your first verified contract."
>
  <main class="go">
    <div class="go-inner">
      <span class="kicker">// scan → copy → paste</span>
      <h1>What is <em>LemmaScript?</em><br>
      <h2>You know how you don't write JavaScript alone because TypeScript adds typing?</h2>
      <h2>Now you need to stop writing TypeScript alone because LemmaScript adds contracts.</h2>
      <p class="what">
        <b>LemmaScript is TypeScript with syntax for contracts</b> — the way TypeScript is JavaScript with syntax for types.<br><br>
        Your agent writes a <code class="inline">//@ contract</code> above a function and iterates until the code is
        proven to meet it. Zero runtime cost. Works on the TypeScript you already have.
      </p>
      <p class="lede">
        Copy the prompt below and paste it into your agent to try it out.
        It installs LemmaScript, picks up the skills, and writes your first verified contract.
      </p>

      <button id="copy" class="copy-btn" type="button" aria-live="polite">
        <span class="copy-label">Copy prompt for your agent</span>
        <span class="copy-done" hidden>Copied — now paste it into your agent</span>
      </button>

      <div class="codeblock prompt-block">
        <div class="code-bar">
          <span class="code-file">prompt.txt</span>
          <button id="copy-2" class="code-copy" type="button">copy</button>
        </div>
        <pre id="prompt" class="code-body prompt-body">{AGENT_PROMPT}</pre>
      </div>

      <p class="fine">
        Prefer to do it by hand? <a href="/install">Install step by step</a> ·
        Agent reading this page? <a href="/go.md">Plain-text version</a>
      </p>
    </div>
  </main>
</BaseLayout>

<script>
  const text = document.getElementById('prompt')!.textContent ?? ''
  const main = document.getElementById('copy') as HTMLButtonElement
  const label = main.querySelector('.copy-label') as HTMLElement
  const done = main.querySelector('.copy-done') as HTMLElement
  const small = document.getElementById('copy-2') as HTMLButtonElement

  async function copy() {
    try {
      await navigator.clipboard.writeText(text)
    } catch {
      // Fallback for browsers that gate the clipboard API: select the text so a long-press / Cmd-C works.
      const range = document.createRange()
      range.selectNodeContents(document.getElementById('prompt')!)
      const sel = window.getSelection()
      sel?.removeAllRanges(); sel?.addRange(range)
      return
    }
    label.hidden = true; done.hidden = false; main.classList.add('is-done')
    small.textContent = 'copied'
    setTimeout(() => { label.hidden = false; done.hidden = true; main.classList.remove('is-done'); small.textContent = 'copy' }, 2600)
  }
  main.addEventListener('click', copy)
  small.addEventListener('click', copy)
</script>

<style>
  .go { min-height: calc(100vh - 64px); display: grid; place-items: start center; padding: var(--sp-12) var(--sp-4) var(--sp-24); }
  .go-inner { width: 100%; max-width: var(--container-narrow); display: flex; flex-direction: column; gap: var(--sp-6); }
  h1 { font-size: clamp(2rem, 6vw, var(--fs-display-l)); line-height: var(--lh-tight); margin: 0; }
  h1 em { font-style: normal; color: var(--accent); }
  .what { font-size: var(--fs-body-lg); color: var(--text-primary); margin: 0; max-width: 56ch; line-height: 1.5;
    padding-left: var(--sp-4); border-left: 3px solid var(--accent); }
  .what b { font-weight: 700; }
  .lede { font-size: var(--fs-body); color: var(--text-secondary); margin: 0; max-width: 56ch; }

  .copy-btn {
    width: 100%; padding: var(--sp-5) var(--sp-6); border: 0; border-radius: var(--r-xl); cursor: pointer;
    font: 700 1.125rem/1.2 var(--font-display); letter-spacing: -0.01em;
    background: var(--accent); color: var(--accent-ink);
    box-shadow: var(--elev-glow); transition: transform var(--dur-1) var(--ease), background var(--dur-2) var(--ease);
  }
  .copy-btn:hover { background: var(--accent-bright); transform: translateY(-1px); }
  .copy-btn:active { transform: translateY(0); }
  .copy-btn.is-done { background: var(--accent-dim); color: var(--text-primary); }

  .prompt-block { position: relative; }
  .code-bar { display: flex; justify-content: space-between; align-items: center; }
  .code-copy { background: none; border: 1px solid var(--border); color: var(--text-secondary); border-radius: var(--r-sm);
    font: 500 var(--fs-caption) var(--font-mono); padding: 2px 8px; cursor: pointer; }
  .code-copy:hover { color: var(--accent); border-color: var(--accent-dim); }
  .prompt-body { white-space: pre-wrap; word-break: break-word; font-size: var(--fs-small); line-height: 1.55; user-select: all; -webkit-user-select: all; }

  .fine { font-size: var(--fs-small); color: var(--text-muted); margin: 0; }
  .fine a { color: var(--text-secondary); text-decoration: underline; text-underline-offset: 3px; }
  .fine a:hover { color: var(--accent); }
</style>
