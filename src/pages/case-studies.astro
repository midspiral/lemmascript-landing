---
import BaseLayout from '../layouts/BaseLayout.astro'

const greenfield = [
  {
    name: 'quota-lemmascript',
    desc: 'A booking application whose core allocation logic is formally verified to never overbook. The same annotated TypeScript produces proofs in both Lean 4 and Dafny.',
    points: ['Provably no overbooking', 'Deployable locally or on Cloudflare', 'Verified in Lean 4 + Dafny'],
    href: 'https://github.com/midspiral/quota-lemmascript',
  },
  {
    name: 'quorum-lemmascript',
    desc: 'A login-free group scheduler whose scheduling logic is proved correct with Dafny — guaranteeing the chosen slot always satisfies every participant’s stated constraints.',
    points: ['Verified scheduling logic', 'No accounts, no backend lock-in', 'Dafny proofs'],
    href: 'https://github.com/midspiral/quorum-lemmascript',
  },
]

const brownfield = [
  {
    name: 'hono-lemmascript',
    desc: 'A fork of the Hono web framework with security-critical middleware formally verified against four real CVEs — demonstrating LemmaScript on production-grade, third-party code.',
    points: ['4 CVEs verified against', 'IP restriction · cookies · path traversal', 'Applied to an existing codebase'],
    href: 'https://github.com/midspiral/hono-lemmascript',
  },
  {
    name: 'opencode-lemmascript',
    desc: 'A fork of opencode with formal verification applied to its permission system. Eleven functions governing access control were proved to honor their contracts.',
    points: ['11 functions verified', 'Permission / access-control logic', 'Applied to an existing codebase'],
    href: 'https://github.com/midspiral/opencode-lemmascript',
  },
]
---

<BaseLayout
  title="Case studies — LemmaScript"
  description="Greenfield builds and brownfield forks of real projects, formally verified with LemmaScript in Lean 4 and Dafny — from booking apps to production frameworks and CVEs."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// case studies</span>
      <h1>Real code, <em>proved</em> correct.</h1>
      <p class="lede">
        Each project below uses the same annotated TypeScript as input and generates machine-checked proofs.
        Greenfield builds show LemmaScript from scratch; brownfield forks show it applied to existing,
        production-grade software.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="cs-head">
        <span class="badge badge-verified"><span class="bdot"></span>Greenfield</span>
        <p>New projects designed around verification from the first line.</p>
      </div>
      <div class="cs-grid">
        {greenfield.map((c) => (
          <a href={c.href} target="_blank" rel="noopener" class="card cs-card">
            <span class="cs-kind">Greenfield</span>
            <h3>{c.name}</h3>
            <p>{c.desc}</p>
            <ul class="cs-points">
              {c.points.map((p) => <li>{p}</li>)}
            </ul>
            <span class="cs-link">View repository →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cs-head">
        <span class="badge badge-pending"><span class="bdot"></span>Brownfield</span>
        <p>Verification retrofitted onto existing, real-world codebases.</p>
      </div>
      <div class="cs-grid">
        {brownfield.map((c) => (
          <a href={c.href} target="_blank" rel="noopener" class="card cs-card">
            <span class="cs-kind brown">Brownfield</span>
            <h3>{c.name}</h3>
            <p>{c.desc}</p>
            <ul class="cs-points">
              {c.points.map((p) => <li>{p}</li>)}
            </ul>
            <span class="cs-link">View repository →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <div class="cs-cta card">
        <span class="kicker">// have a codebase to verify?</span>
        <h2>Bring LemmaScript to your own code.</h2>
        <p class="section-desc" style="margin:var(--sp-3) auto var(--sp-8);max-width:48ch">Start with one critical function or a whole module — greenfield or a fork.</p>
        <div class="cs-actions">
          <a href="/how-it-works" class="btn btn-primary">See how it works →</a>
          <a href="https://github.com/midspiral/LemmaScript" target="_blank" rel="noopener" class="btn btn-secondary">View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cs-head { display: flex; align-items: center; gap: var(--sp-4); margin-bottom: var(--sp-8); flex-wrap: wrap; }
  .cs-head p { font-size: var(--fs-small); color: var(--text-muted); }

  .cs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
  .cs-card { display: flex; flex-direction: column; }
  .cs-kind { font-family: var(--font-mono); font-size: var(--fs-caption); text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); }
  .cs-kind.brown { color: var(--state-pending); }
  .cs-card h3 { font-family: var(--font-mono); font-weight: 600; font-size: var(--fs-h3); margin: var(--sp-2) 0; }
  .cs-card p { font-size: var(--fs-small); }
  .cs-points { list-style: none; margin: var(--sp-4) 0; display: grid; gap: var(--sp-2); }
  .cs-points li { font-size: var(--fs-small); color: var(--text-secondary); padding-left: var(--sp-4); position: relative; }
  .cs-points li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-family: var(--font-mono); }
  .cs-link { margin-top: auto; font-size: var(--fs-small); color: var(--text-muted); }
  .cs-card:hover .cs-link { color: var(--accent); }

  .cs-cta { padding: var(--sp-16); box-shadow: var(--elev-glow); }
  .cs-cta h2 { font-size: var(--fs-h1); margin-top: var(--sp-3); }
  .cs-actions { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .cs-grid { grid-template-columns: 1fr; }
  }
</style>
