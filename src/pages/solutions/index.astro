---
import BaseLayout from '../../layouts/BaseLayout.astro'

const solutions = [
  {
    href: '/solutions/web-apps',
    tag: 'Web apps',
    title: 'Core logic that holds under any load.',
    desc: 'The business logic that breaks in the costliest ways — allocation, counting, state transitions. Correct by construction, so the invariant holds for every request.',
    example: 'See: quota-lemmascript',
  },
  {
    href: '/solutions/algorithms',
    tag: 'Algorithms',
    title: 'Output that\'s guaranteed right — not just tested.',
    desc: 'A contract defines what the output must satisfy. The agent iterates until the implementation meets it for every input. The guarantee travels with the code.',
    example: 'See: quorum-lemmascript',
  },
  {
    href: '/solutions/security',
    tag: 'Security patches',
    title: 'A fix that holds for every input, not just the advisory.',
    desc: 'Close the gap between "fixed for the known exploit" and "fixed for all inputs." The contract covers every case — not just the proof-of-concept.',
    example: 'See: hono-lemmascript',
  },
  {
    href: '/solutions/agents',
    tag: 'Agents',
    title: 'Rules that hold for every ruleset.',
    desc: 'Access control and permission logic that has to be right for every ruleset an operator can configure — not just the ones anyone thought to test.',
    example: 'See: opencode-lemmascript',
  },
]
---

<BaseLayout
  title="Solutions — LemmaScript"
  description="LemmaScript in practice: web apps, algorithms, security patches, and agent systems — each with a real example and a description of how contracts make the critical logic correct by construction."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// solutions</span>
      <h1>Correct by construction, <em>wherever it matters.</em></h1>
      <p class="lede">
        LemmaScript works on any TypeScript where correctness matters — business logic,
        algorithms, security-critical code, agent rules. Each use case below links to a
        real, working example.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="sol-grid">
        {solutions.map((s) => (
          <a href={s.href} class="card sol-card">
            <span class="sol-tag">{s.tag}</span>
            <h2>{s.title}</h2>
            <p>{s.desc}</p>
            <span class="sol-example">{s.example}</span>
            <span class="sol-link">Explore this use case →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sol-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
  }

  .sol-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .sol-tag {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .sol-card h2 {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: var(--lh-tight);
  }

  .sol-card p {
    font-size: var(--fs-small);
    color: var(--text-secondary);
    line-height: 1.65;
    flex: 1;
  }

  .sol-example {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  .sol-link {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin-top: auto;
  }

  .sol-card:hover .sol-link {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .sol-grid { grid-template-columns: 1fr; }
  }
</style>
