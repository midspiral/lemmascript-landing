---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Algorithms — LemmaScript Solutions"
  description="Make algorithmic functions correct by construction — a contract defines what the output must satisfy, and the agent iterates until the implementation meets it for every input."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// solutions / algorithms</span>
      <h1>Output that's guaranteed right — <em>not just tested.</em></h1>
      <p class="lede">
        An algorithm either returns the right answer or it doesn't. Tests sample a
        handful of inputs and call it done. A contract defines what "right" means
        for every input — and the code either satisfies it or it doesn't ship.
      </p>
    </div>
  </header>

  <!-- CONTRACT IN ACTION -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// contract in action</span>
        <h2>The postcondition defines what the output must be.</h2>
        <p class="section-desc">
          The contract doesn't say how to compute the answer — it says what the answer
          must satisfy. The implementation can change; the guarantee can't.
        </p>
      </div>
      <div class="codeblock">
        <div class="code-bar">
          <span class="code-file">src/schedule.ts</span>
          <span class="badge badge-verified" style="margin-left:auto">Guaranteed</span>
        </div>
        <pre class="code-body"><span class="t-cmt">// find the slots the most participants can attend</span>
<span class="t-kw">function</span> <span class="t-fn">bestSlots</span>(slots: Slot[], availability: Availability[]): Slot[] &#123;
  <span class="t-anno">//@ ensures \result.length >= 1</span>
  <span class="t-anno">//@ ensures \forall s in \result: countFree(s, availability) === maxFree(slots, availability)</span>
  <span class="t-anno">//@ ensures \forall s in slots: countFree(s, availability) &lt;= countFree(\result[0], availability)</span>

  <span class="t-kw">const</span> max = Math.max(...slots.map(s =&gt; countFree(s, availability)))
  <span class="t-kw">return</span> slots.filter(s =&gt; countFree(s, availability) === max)
&#125;</pre>
      </div>
      <div class="snippet-callouts">
        <div class="callout-item">
          <span class="callout-marker t-anno">①</span>
          <p>Always returns at least one slot — no silent empty result.</p>
        </div>
        <div class="callout-item">
          <span class="callout-marker t-anno">②</span>
          <p>Every returned slot has exactly the maximum count — no near-miss, no tie reported as a winner.</p>
        </div>
        <div class="callout-item">
          <span class="callout-marker t-anno">③</span>
          <p>No other slot in the full list beats the result — this really is the best.</p>
        </div>
      </div>
      <p class="code-caption">Representative contract from <a href="https://github.com/midspiral/quorum-lemmascript" target="_blank" rel="noopener" class="link-arrow">quorum-lemmascript ↗</a></p>
    </div>
  </section>

  <!-- INPUT SPACE DIAGRAM -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// the gap tests leave open</span>
        <h2>Tests cover what you wrote. A contract covers everything.</h2>
        <p class="section-desc">
          Your test suite exercises real behavior on the inputs you chose. The contract
          adds what tests can't: a guarantee the function is correct on every input,
          including the ones nobody thought of.
        </p>
      </div>

      <div class="coverage-diagram">
        <div class="coverage-col">
          <span class="coverage-title">Tests</span>
          <div class="coverage-space">
            <span class="coverage-space-label">all possible inputs</span>
            <div class="coverage-dots">
              <span class="dot dot-covered" title="tested"></span>
              <span class="dot dot-covered" title="tested"></span>
              <span class="dot" title="untested"></span>
              <span class="dot dot-covered" title="tested"></span>
              <span class="dot" title="untested"></span>
              <span class="dot" title="untested"></span>
              <span class="dot dot-covered" title="tested"></span>
              <span class="dot" title="untested"></span>
              <span class="dot dot-covered" title="tested"></span>
              <span class="dot" title="untested"></span>
              <span class="dot" title="untested"></span>
              <span class="dot" title="untested"></span>
              <span class="dot dot-covered" title="tested"></span>
              <span class="dot" title="untested"></span>
              <span class="dot" title="untested"></span>
              <span class="dot dot-covered" title="tested"></span>
            </div>
          </div>
          <div class="coverage-legend">
            <span><span class="dot dot-covered dot-sm"></span> tested</span>
            <span><span class="dot dot-sm"></span> not tested</span>
          </div>
        </div>

        <div class="coverage-vs">vs</div>

        <div class="coverage-col">
          <span class="coverage-title">Contract</span>
          <div class="coverage-space coverage-space-full">
            <span class="coverage-space-label">all possible inputs</span>
            <div class="coverage-dots">
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
              <span class="dot dot-guaranteed" title="guaranteed"></span>
            </div>
          </div>
          <div class="coverage-legend">
            <span><span class="dot dot-guaranteed dot-sm"></span> guaranteed correct</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// what you get</span>
        <h2>A result that's always right.</h2>
      </div>
      <div class="what-grid">
        <div class="what-item">
          <h3>Every input covered</h3>
          <p>The contract holds for all inputs — not a sample, not a suite. The cases nobody wrote a test for are already covered.</p>
        </div>
        <div class="what-item">
          <h3>Regression-proof</h3>
          <p>Optimize or restructure the implementation and the contract re-checks from scratch. A regression fails the check before it ships.</p>
        </div>
        <div class="what-item">
          <h3>One verified core, anywhere</h3>
          <p>The same guaranteed function runs on the client, server, or edge — no second implementation to maintain and drift.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- EXAMPLE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// example</span>
        <h2>A group scheduler whose "best time" is guaranteed right.</h2>
        <p class="section-desc">
          Quorum is a login-free group scheduler. The slot it recommends is guaranteed
          to be the one the most participants can attend — not a near-miss, not a tie
          reported as a winner.
        </p>
      </div>
      <div class="ex-stats">
        <div class="ex-stat">
          <span class="ex-val">exact</span>
          <span class="ex-label">every count matches who's actually free</span>
        </div>
        <div class="ex-stat">
          <span class="ex-val">order</span>
          <span class="ex-label">independent — any device, any order</span>
        </div>
        <div class="ex-stat">
          <span class="ex-val">1</span>
          <span class="ex-label">verified core, client + server</span>
        </div>
      </div>
      <div class="ex-actions">
        <a href="/case-studies/quorum" class="btn btn-primary">Read the case study →</a>
        <a href="/solutions" class="btn btn-secondary">All solutions</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* snippet callout annotations */
  .snippet-callouts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }
  .callout-item {
    display: flex;
    gap: var(--sp-3);
    align-items: baseline;
  }
  .callout-marker {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 700;
    flex-shrink: 0;
  }
  .callout-item p {
    font-size: var(--fs-small);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .code-caption {
    font-size: var(--fs-caption);
    color: var(--text-faint);
    font-family: var(--font-mono);
    margin-top: var(--sp-4);
  }

  /* coverage diagram */
  .coverage-diagram {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-10);
    padding: var(--sp-8) 0;
  }
  .coverage-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }
  .coverage-title {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .coverage-space {
    width: 240px;
    padding: var(--sp-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .coverage-space-full {
    border-color: var(--accent-dim);
    background: var(--state-verified-bg);
    box-shadow: var(--elev-glow);
  }
  .coverage-space-label {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    text-align: center;
  }
  .coverage-dots {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-2);
    justify-items: center;
  }
  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--border);
    border: 1px solid var(--border-subtle);
  }
  .dot-sm { width: 10px; height: 10px; }
  .dot-covered { background: var(--state-info-bg); border-color: rgba(91,168,255,0.4); }
  .dot-guaranteed { background: var(--state-verified-bg); border-color: var(--accent-dim); box-shadow: 0 0 6px var(--accent-glow); }
  .coverage-legend {
    display: flex;
    gap: var(--sp-4);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    font-family: var(--font-mono);
    align-items: center;
  }
  .coverage-legend span { display: flex; align-items: center; gap: var(--sp-2); }
  .coverage-vs {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
    font-weight: 600;
  }

  /* shared */
  .what-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .what-item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); padding: var(--sp-6); }
  .what-item h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-3); }
  .what-item p { font-size: var(--fs-small); color: var(--text-secondary); line-height: 1.65; }

  .ex-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); margin-bottom: var(--sp-10); }
  .ex-stat { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); padding: var(--sp-6); }
  .ex-val { display: block; font-family: var(--font-mono); font-size: 2rem; font-weight: 700; color: var(--accent); margin-bottom: var(--sp-2); }
  .ex-label { font-size: var(--fs-small); color: var(--text-muted); }
  .ex-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }

  @media (max-width: 860px) {
    .snippet-callouts, .what-grid, .ex-stats { grid-template-columns: 1fr; }
    .coverage-diagram { flex-direction: column; }
  }
</style>
