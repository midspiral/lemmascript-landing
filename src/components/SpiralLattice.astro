---
interface Props {
  id?: string
  width?: number
  height?: number
}

const { id = 'lattice', width = 1400, height = 520 } = Astro.props
---

<div class="hero-lattice" id={id} aria-hidden="true"
  data-width={width} data-height={height}></div>

<script is:inline>
  (function() {
    var el = document.querySelector('.hero-lattice[id]');
    if (!el) return;
    var W = parseInt(el.dataset.width) || 1400;
    var H = parseInt(el.dataset.height) || 520;
    var cellSize = 40;
    var cols = Math.ceil(W / cellSize);
    var rows = Math.ceil(H / cellSize);

    function squareSpiral(cx, cy, size) {
      var half = size / 2;
      var pts = [];
      pts.push([cx, cy]);
      var dirs = [[1,0],[0,-1],[-1,0],[0,1]];
      var x = cx, y = cy;
      for (var ring = 1; ring <= Math.floor(half); ring++) {
        for (var d = 0; d < 4; d++) {
          if (d === 0) var steps = ring;
          else if (d === 1) steps = ring * 2 - 1;
          else if (d === 2) steps = ring * 2;
          else steps = ring * 2;
          for (var s = 0; s < steps; s++) {
            x += dirs[d][0];
            y += dirs[d][1];
            pts.push([x, y]);
          }
        }
      }
      return pts;
    }

    var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + ' ' + H + '">';
    for (var r = 0; r < rows; r++) {
      for (var c = 0; c < cols; c++) {
        var cx = c * cellSize + cellSize / 2;
        var cy = r * cellSize + cellSize / 2;
        var pts = squareSpiral(0, 0, cellSize);
        var d = 'M';
        for (var i = 0; i < pts.length; i++) {
          d += (cx + pts[i][0]) + ',' + (cy + pts[i][1]);
          if (i < pts.length - 1) d += ' L';
        }
        svg += '<path d="' + d + '" fill="none" stroke="#B8ADE0" stroke-width="1" opacity="0.45"/>';
      }
    }
    svg += '</svg>';
    el.innerHTML = svg;
  })();
</script>
