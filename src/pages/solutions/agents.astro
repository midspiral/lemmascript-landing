---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Agents — LemmaScript Solutions"
  description="Make the logic your agents operate under correct by construction — access control and permission rules that hold for every ruleset an operator can configure."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// solutions / agents</span>
      <h1>Rules that hold for <em>every ruleset.</em></h1>
      <p class="lede">
        When an agent's behavior depends on permission or access-control logic, that
        logic has to be right for every ruleset — not just the ones in the test suite.
        LemmaScript makes those rules correct by construction.
      </p>
    </div>
  </header>

  <!-- CONTRACT IN ACTION -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// contract in action</span>
        <h2>The rules operators set — guaranteed to hold.</h2>
        <p class="section-desc">
          Three contracts on the same permission evaluator, each expressing a rule that
          must hold regardless of how the ruleset is configured.
        </p>
      </div>
      <div class="codeblock">
        <div class="code-bar">
          <span class="code-file">src/permission.ts</span>
          <span class="badge badge-verified" style="margin-left:auto">Guaranteed</span>
        </div>
        <pre class="code-body"><span class="t-cmt">//</span><span class="t-at">@</span> <span class="t-dir-contract">contract</span> <span class="t-prose">Deny always wins, no match means ask, and the decision is always valid.</span>
<span class="t-kw">function</span> <span class="t-fn">evaluate</span>(rules: Rule[], req: Request): Decision &#123;
  <span class="t-cmt">// deny always wins — an earlier allow can't override a later deny</span>
  <span class="t-cmt">//</span><span class="t-at">@</span> <span class="t-dir-ensures">ensures</span> <span class="t-annokw">(<span class="t-quant">exists</span>(k, 0 &lt;= k &amp;&amp; k &lt; rules.length &amp;&amp; rules[k].type === 'deny' &amp;&amp; matches(rules[k], req)))</span>
  <span class="t-cmt">//   ==&gt; \result === 'deny'</span>

  <span class="t-cmt">// no match means ask, never allow</span>
  <span class="t-cmt">//</span><span class="t-at">@</span> <span class="t-dir-ensures">ensures</span> <span class="t-annokw">!(<span class="t-quant">exists</span>(k, 0 &lt;= k &amp;&amp; k &lt; rules.length &amp;&amp; matches(rules[k], req)))</span>
  <span class="t-cmt">//   ==&gt; \result === 'ask'</span>

  <span class="t-cmt">// result is always a valid decision</span>
  <span class="t-cmt">//</span><span class="t-at">@</span> <span class="t-dir-ensures">ensures</span> <span class="t-annokw"><span class="t-result">\result</span> === 'allow' || <span class="t-result">\result</span> === 'deny' || <span class="t-result">\result</span> === 'ask'</span>

  <span class="t-kw">for</span> (<span class="t-kw">const</span> rule <span class="t-kw">of</span> rules) &#123;
    <span class="t-kw">if</span> (rule.type === <span class="t-str">'deny'</span> &amp;&amp; matches(rule, req)) <span class="t-kw">return</span> <span class="t-str">'deny'</span>
  &#125;
  <span class="t-kw">for</span> (<span class="t-kw">const</span> rule <span class="t-kw">of</span> rules) &#123;
    <span class="t-kw">if</span> (rule.type === <span class="t-str">'allow'</span> &amp;&amp; matches(rule, req)) <span class="t-kw">return</span> <span class="t-str">'allow'</span>
  &#125;
  <span class="t-kw">return</span> <span class="t-str">'ask'</span>
&#125;</pre>
      </div>
      <p class="code-caption">
        Representative contract from <a href="https://github.com/midspiral/opencode-lemmascript" target="_blank" rel="noopener" class="link-arrow">opencode-lemmascript ↗</a>
      </p>
    </div>
  </section>

  <!-- RULESET EVALUATION DIAGRAM -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// the guarantee in practice</span>
        <h2>Deny means deny — for every ruleset an operator can write.</h2>
        <p class="section-desc">
          The contract doesn't just enforce the rule on the rulesets you tested.
          It holds for every possible combination of rules and requests.
        </p>
      </div>

      <div class="ruleset-diagram">
        <div class="ruleset-header">
          <span class="ruleset-col-label">Operator configures</span>
          <span class="ruleset-col-label">Agent requests</span>
          <span class="ruleset-col-label">Result</span>
          <span class="ruleset-col-label">Guaranteed by</span>
        </div>

        <div class="ruleset-row">
          <div class="ruleset-cell">
            <code class="rule-deny">deny edits in plan mode</code>
          </div>
          <div class="ruleset-cell">
            <code class="rule-req">edit file.ts</code>
          </div>
          <div class="ruleset-cell">
            <span class="badge badge-counter"><span class="bdot"></span>deny</span>
          </div>
          <div class="ruleset-cell rule-contract">
            <code class="t-anno">deny always wins</code>
          </div>
        </div>

        <div class="ruleset-row">
          <div class="ruleset-cell">
            <code class="rule-deny">deny edits in plan mode</code>
            <code class="rule-note">+ subagent spawned</code>
          </div>
          <div class="ruleset-cell">
            <code class="rule-req">subagent: edit file.ts</code>
          </div>
          <div class="ruleset-cell">
            <span class="badge badge-counter"><span class="bdot"></span>deny</span>
          </div>
          <div class="ruleset-cell rule-contract">
            <code class="t-anno">inherits from parent</code>
          </div>
        </div>

        <div class="ruleset-row">
          <div class="ruleset-cell">
            <code class="rule-empty">(no matching rule)</code>
          </div>
          <div class="ruleset-cell">
            <code class="rule-req">run unknown command</code>
          </div>
          <div class="ruleset-cell">
            <span class="badge badge-pending"><span class="bdot"></span>ask</span>
          </div>
          <div class="ruleset-cell rule-contract">
            <code class="t-anno">no match → ask</code>
          </div>
        </div>

        <div class="ruleset-row">
          <div class="ruleset-cell">
            <code class="rule-allow">allow npm run dev</code>
            <code class="rule-deny">+ deny npm run dev --force</code>
          </div>
          <div class="ruleset-cell">
            <code class="rule-req">npm run dev --force</code>
          </div>
          <div class="ruleset-cell">
            <span class="badge badge-counter"><span class="bdot"></span>deny</span>
          </div>
          <div class="ruleset-cell rule-contract">
            <code class="t-anno">longest match wins</code>
          </div>
        </div>
      </div>

      <p class="diagram-note">These outcomes don't depend on test coverage. The contracts make them unconditional.</p>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// what you get</span>
        <h2>Constraints operators set actually hold.</h2>
      </div>
      <div class="what-grid">
        <div class="what-item">
          <h3>Every ruleset covered</h3>
          <p>The contract holds for all rulesets — not just the ones tested. An operator who sets a deny rule can trust it holds for every request that follows.</p>
        </div>
        <div class="what-item">
          <h3>Applied in place</h3>
          <p>The guarantee lives in the production permission functions, not in a test added alongside the fix. No drift, no copy to maintain.</p>
        </div>
        <div class="what-item">
          <h3>Safe across the agent boundary</h3>
          <p>Invariants that must hold for the parent agent hold for any subagent it spawns — the guarantee propagates, not just the configuration.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- EXAMPLE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// example</span>
        <h2>A coding agent's permission system — guaranteed to hold the line.</h2>
        <p class="section-desc">
          A fork of the opencode coding agent with its permission system locked down —
          eleven access-control functions guaranteed to honor their rules, including a
          real Plan-Mode bypass closed for good.
        </p>
      </div>
      <div class="ex-stats">
        <div class="ex-stat">
          <span class="ex-val">11</span>
          <span class="ex-label">permission functions guaranteed</span>
        </div>
        <div class="ex-stat">
          <span class="ex-val">in-place</span>
          <span class="ex-label">bodies and signatures unchanged</span>
        </div>
        <div class="ex-stat">
          <span class="ex-val">#26514</span>
          <span class="ex-label">real Plan-Mode bypass closed</span>
        </div>
      </div>
      <div class="ex-actions">
        <a href="/case-studies/opencode" class="btn btn-primary">Read the case study →</a>
        <a href="/solutions" class="btn btn-secondary">All solutions</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .code-caption {
    font-size: var(--fs-caption);
    color: var(--text-faint);
    font-family: var(--font-mono);
    margin-top: var(--sp-4);
  }

  /* ruleset diagram */
  .ruleset-diagram {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin: var(--sp-6) 0;
  }
  .ruleset-header {
    display: grid;
    grid-template-columns: 2fr 1.5fr 1fr 1.5fr;
    gap: var(--sp-4);
    padding: 0 var(--sp-5) var(--sp-2);
  }
  .ruleset-col-label {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ruleset-row {
    display: grid;
    grid-template-columns: 2fr 1.5fr 1fr 1.5fr;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-4) var(--sp-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
  }
  .ruleset-row:hover { border-color: var(--border); }
  .ruleset-cell {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }
  .rule-deny { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--state-counter); }
  .rule-allow { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--accent); }
  .rule-empty { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-faint); font-style: italic; }
  .rule-req { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-secondary); }
  .rule-note { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-muted); }
  .rule-contract code { font-family: var(--font-mono); font-size: var(--fs-caption); }

  .diagram-note {
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-top: var(--sp-4);
  }

  /* shared */
  .what-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .what-item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); padding: var(--sp-6); }
  .what-item h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-3); }
  .what-item p { font-size: var(--fs-small); color: var(--text-secondary); line-height: 1.65; }

  .ex-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); margin-bottom: var(--sp-10); }
  .ex-stat { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); padding: var(--sp-6); }
  .ex-val { display: block; font-family: var(--font-mono); font-size: 2rem; font-weight: 700; color: var(--accent); margin-bottom: var(--sp-2); }
  .ex-label { font-size: var(--fs-small); color: var(--text-muted); }
  .ex-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }

  @media (max-width: 860px) {
    .ruleset-header { display: none; }
    .ruleset-row { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; }
    .what-grid, .ex-stats { grid-template-columns: 1fr; }
  }
</style>
