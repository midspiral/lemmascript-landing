---
import BaseLayout from '../layouts/BaseLayout.astro'

const features = [
  { t: 'Contracts in plain comments', d: 'Write what a function must do as //@ comments in ordinary TypeScript. Your editor, type-checker, linter, and CI treat them as comments — LemmaScript treats them as a binding contract.' },
  { t: 'Correct by construction', d: 'Code is built to honor its contract from the first line — guaranteed for every input, not patched in after a bug report.' },
  { t: 'Built for AI agents', d: 'Agents write the contracts and the code together and iterate until it’s correct. You review plain TypeScript; you never have to write LemmaScript yourself.' },
  { t: 'Review the spec, not the code', d: 'A few declarative contracts say what the code must do. Reviewing intent takes a glance — the implementation is the agent’s job.' },
  { t: 'Works on existing code', d: 'Adopt it as far as you want — one critical function or a whole module, greenfield or a fork of a production codebase.' },
  { t: 'Zero runtime cost', d: 'Everything happens at build time. What ships is your original TypeScript — no wrappers, no checks, no overhead.' },
]
---

<BaseLayout
  title="Features — LemmaScript"
  description="What LemmaScript gives you: contracts in plain TypeScript comments, code that's correct by construction, agent-first authoring, glance-able review, and zero runtime cost."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// features</span>
      <h1>Everything you need to ship <em>correct</em> code.</h1>
      <p class="lede">
        LemmaScript adds contracts to TypeScript — so the code your team and your agents ship is
        correct by construction, and easy to review.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="feat-grid">
        {features.map((f) => (
          <div class="card feat">
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </div>
        ))}
      </div>
      <div class="feat-cta">
        <a href="/install" class="btn btn-primary">Install →</a>
        <a href="/try" class="btn btn-secondary">Try it live</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .feat h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-2); }
  .feat p { font-size: var(--fs-small); color: var(--text-secondary); }
  .feat-cta { display: flex; gap: var(--sp-3); justify-content: center; margin-top: var(--sp-12); }
  @media (max-width: 860px) { .feat-grid { grid-template-columns: 1fr; } }
</style>
