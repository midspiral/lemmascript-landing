---
// Interactive in-browser checker. The visitor edits a function and its contract;
// the engine samples inputs that satisfy //@ requires and checks //@ ensures,
// flagging any input that doesn’t yet satisfy the contract, or confirming all do.
const scenarios = [
  {
    id: 'charge',
    label: 'charge',
    note: 'No overbooking',
    code: `//@ requires remaining >= 0 && cost >= 0
//@ ensures \\result >= 0
//@ ensures \\result <= remaining
function charge(remaining: number, cost: number): number {
  if (cost > remaining) return 0;
  return remaining - cost;
}`,
  },
  {
    id: 'abs',
    label: 'abs',
    note: 'Always non-negative',
    code: `//@ ensures \\result >= 0
//@ ensures \\result == n || \\result == -n
function abs(n: number): number {
  if (n < 0) return -n;
  return n;
}`,
  },
  {
    id: 'clamp',
    label: 'clamp',
    note: 'Stays within bounds',
    code: `//@ requires lo <= hi
//@ ensures \\result >= lo && \\result <= hi
function clamp(x: number, lo: number, hi: number): number {
  if (x < lo) return lo;
  if (x > hi) return hi;
  return x;
}`,
  },
]
---

<section class="pg">
  <div class="container">
    <div class="section-head pg-head">
      <span class="kicker">// watch it work</span>
      <h2>Edit the code. LemmaScript holds it to its contract.</h2>
      <p class="section-desc">This runs entirely in your browser. Change the code or its <code class="pg-inline">//@</code> contract, hit Check, and LemmaScript holds the code to its contract — for every input.</p>
    </div>

    <div class="pg-shell">
      <div class="pg-toolbar">
        <div class="pg-tabs" role="tablist" aria-label="Examples">
          {scenarios.map((s, i) => (
            <button class:list={['pg-tab', { active: i === 0 }]} data-scenario={s.id} role="tab" aria-selected={i === 0}>
              {s.label}<span class="pg-tab-note">{s.note}</span>
            </button>
          ))}
        </div>
        <div class="pg-toolbar-right">
          <button class="pg-verify" id="pg-verify">▸ Check</button>
        </div>
      </div>

      <div class="pg-body">
        <div class="pg-editor">
          <div class="pg-editor-bar"><span class="dots"><i></i><i></i><i></i></span><span class="pg-filename">scratch.ts</span></div>
          <textarea id="pg-code" spellcheck="false" aria-label="TypeScript editor"></textarea>
        </div>
        <div class="pg-output" id="pg-output" aria-live="polite">
          <div class="pg-idle">
            <span class="pg-idle-mark">//@</span>
            <p>Press <b>Check</b> to test this function against its contract.</p>
          </div>
        </div>
      </div>
    </div>
    <p class="pg-disclaimer">// Runs in your browser — tries every input from -64 to 64. The full LemmaScript engine guarantees it for all of them.</p>
  </div>
</section>

<script is:inline define:vars={{ scenarios }}>
  (function () {
    const codeEl = document.getElementById('pg-code')
    const outEl = document.getElementById('pg-output')
    const verifyBtn = document.getElementById('pg-verify')
    const tabs = Array.from(document.querySelectorAll('.pg-tab'))

    const byId = Object.fromEntries(scenarios.map((s) => [s.id, s]))
    function load(id) {
      codeEl.value = byId[id].code
      autoSize()
      resetOutput()
    }
    function autoSize() {
      codeEl.style.height = 'auto'
      codeEl.style.height = codeEl.scrollHeight + 'px'
    }
    function resetOutput() {
      outEl.innerHTML =
        '<div class="pg-idle"><span class="pg-idle-mark">//@</span><p>Press <b>Check</b> to test this function against its contract.</p></div>'
    }

    // ---- engine ----
    function stripTypes(src) {
      return src
        .replace(/:\s*number\[\]/g, '')
        .replace(/:\s*number/g, '')
        .replace(/:\s*boolean/g, '')
        .replace(/:\s*string/g, '')
    }
    function parse(src) {
      const requires = []
      const ensures = []
      src.split('\n').forEach((line) => {
        const r = line.match(/\/\/@\s*requires\s+(.+)/)
        if (r) requires.push(r[1].trim())
        const e = line.match(/\/\/@\s*ensures\s+(.+)/)
        if (e) ensures.push(e[1].trim())
      })
      const fm = src.match(/function\s+(\w+)\s*\(([^)]*)\)/)
      if (!fm) return null
      const name = fm[1]
      const params = fm[2]
        .split(',')
        .map((p) => p.trim())
        .filter(Boolean)
        .map((p) => {
          const [n, t] = p.split(':')
          return { name: n.trim(), type: (t || 'number').trim() }
        })
      return { requires, ensures, name, params }
    }
    function toPred(expr, argNames) {
      const js = expr.replace(/\\result/g, '__result')
      return new Function(...argNames, '__result', 'return (' + js + ');')
    }

    function verify(src) {
      const meta = parse(src)
      if (!meta || !meta.params.length) return { kind: 'error', msg: 'Could not find a function to check.' }
      // only numeric scalar params supported in the browser check
      if (!meta.params.every((p) => p.type === 'number')) {
        return { kind: 'error', msg: 'The in-browser demo supports numeric parameters.' }
      }
      let fn, reqs, enss
      try {
        fn = new Function(stripTypes(src) + '\nreturn ' + meta.name + ';')()
        const argNames = meta.params.map((p) => p.name)
        reqs = meta.requires.map((e) => toPred(e, argNames))
        enss = meta.ensures.map((e, i) => ({ pred: toPred(e, argNames), text: meta.ensures[i] }))
      } catch (err) {
        return { kind: 'error', msg: 'Parse error: ' + err.message }
      }

      const LO = -64
      const HI = 64
      let checked = 0
      const sample = (vals) => {
        try {
          if (!reqs.every((r) => r(...vals, undefined))) return null
        } catch (e) {
          return null
        }
        checked++
        let result
        try {
          result = fn(...vals)
        } catch (e) {
          return { vals, text: 'threw ' + e.message, threw: true }
        }
        for (const en of enss) {
          let ok
          try {
            ok = en.pred(...vals, result)
          } catch (e) {
            ok = false
          }
          if (!ok) return { vals, result, text: en.text }
        }
        return null
      }

      const n = meta.params.length
      // exhaustive grid for 1-2 params, randomized for more
      if (n <= 2) {
        for (let a = LO; a <= HI; a++) {
          if (n === 1) {
            const cx = sample([a])
            if (cx) return finishCx(cx, meta, checked)
          } else {
            for (let b = LO; b <= HI; b++) {
              const cx = sample([a, b])
              if (cx) return finishCx(cx, meta, checked)
            }
          }
        }
      } else {
        for (let i = 0; i < 40000; i++) {
          const vals = meta.params.map(() => Math.floor(Math.random() * (HI - LO + 1)) + LO)
          const cx = sample(vals)
          if (cx) return finishCx(cx, meta, checked)
        }
      }
      return { kind: 'verified', checked, meta }
    }
    function finishCx(cx, meta, checked) {
      return { kind: 'counter', cx, meta, checked }
    }

    function render(res) {
      if (res.kind === 'error') {
        outEl.innerHTML = `<div class="pg-result pg-err"><div class="pg-r-head"><span class="badge badge-pending"><span class="bdot"></span>Cannot check</span></div><p class="pg-r-msg">${esc(res.msg)}</p></div>`
        return
      }
      if (res.kind === 'counter') {
        const args = res.meta.params.map((p, i) => `${p.name} = ${res.cx.vals[i]}`).join(', ')
        const got = res.cx.threw ? res.cx.text : `\\result = ${fmt(res.cx.result)}`
        outEl.innerHTML = `<div class="pg-result pg-counter">
          <div class="pg-r-head"><span class="badge badge-counter"><span class="bdot"></span>Not correct yet</span><span class="pg-r-count">after ${res.checked.toLocaleString()} inputs</span></div>
          <div class="pg-cx">
            <div class="pg-cx-row"><span class="pg-cx-k">input</span><code>${esc(args)}</code></div>
            <div class="pg-cx-row"><span class="pg-cx-k">got</span><code>${esc(got)}</code></div>
            <div class="pg-cx-row"><span class="pg-cx-k">unmet</span><code class="pg-violate">//@ ensures ${esc(res.cx.text)}</code></div>
          </div>
          <p class="pg-r-foot">This input doesn’t satisfy the contract yet. In the real loop, your agent revises the code and checks again — until it’s correct.</p>
        </div>`
        return
      }
      // guaranteed
      outEl.innerHTML = `<div class="pg-result pg-ok">
        <div class="pg-r-head"><span class="badge badge-verified"><span class="bdot"></span>Guaranteed</span><span class="pg-r-count">${res.checked.toLocaleString()} inputs · all correct</span></div>
        <div class="pg-guarantee">This code is correct by construction — it honors its contract for every input.</div>
        <p class="pg-r-foot">Every input checked honors the contract. The full LemmaScript engine guarantees it for all of them.</p>
      </div>`
    }

    function esc(s) {
      return String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]))
    }
    function fmt(v) {
      return typeof v === 'number' && !Number.isInteger(v) ? v.toFixed(2) : String(v)
    }

    function run() {
      verifyBtn.disabled = true
      verifyBtn.textContent = '⋯ Checking'
      outEl.innerHTML = '<div class="pg-running"><span class="pg-spin"></span> checking against the contract…</div>'
      setTimeout(() => {
        let res
        try {
          res = verify(codeEl.value)
        } catch (e) {
          res = { kind: 'error', msg: e.message }
        }
        render(res)
        verifyBtn.disabled = false
        verifyBtn.textContent = '▸ Check'
      }, 420)
    }

    // ---- wiring ----
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tabs.forEach((x) => {
          x.classList.remove('active')
          x.setAttribute('aria-selected', 'false')
        })
        t.classList.add('active')
        t.setAttribute('aria-selected', 'true')
        load(t.dataset.scenario)
      })
    )
    codeEl.addEventListener('input', autoSize)
    verifyBtn.addEventListener('click', run)

    load(scenarios[0].id)
  })()
</script>

<style>
  .pg { padding-block: var(--sp-24); }
  .pg-head { margin-inline: auto; text-align: center; }
  .pg-inline { font-family: var(--font-mono); color: var(--accent-bright); font-size: 0.9em; }

  .pg-shell { border: 1px solid var(--border); border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--elev-2); background: var(--bg-surface); }

  .pg-toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-4); border-bottom: 1px solid var(--border-subtle); background: var(--bg-overlay); flex-wrap: wrap; }
  .pg-tabs { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .pg-tab { display: inline-flex; align-items: center; gap: var(--sp-2); font-family: var(--font-mono); font-size: var(--fs-small);
    color: var(--text-muted); background: transparent; border: 1px solid transparent; border-radius: var(--r-md);
    height: 42px; padding: 0 var(--sp-3); cursor: pointer; transition: all var(--dur-1) var(--ease); }
  .pg-tab:hover { color: var(--text-secondary); }
  .pg-tab.active { color: var(--accent); background: var(--state-verified-bg); border-color: var(--accent-dim); }
  .pg-tab-note { font-size: var(--fs-caption); color: var(--text-faint); }
  .pg-tab.active .pg-tab-note { color: var(--accent-dim); }

  .pg-toolbar-right { display: flex; align-items: center; gap: var(--sp-3); }
  .pg-verify { display: inline-flex; align-items: center; font-family: var(--font-mono); font-size: var(--fs-small); font-weight: 600;
    height: 42px; padding: 0 var(--sp-4);
    background: var(--accent); color: var(--accent-ink); border: none; border-radius: var(--r-md); cursor: pointer; transition: all var(--dur-2) var(--ease); }
  .pg-verify:hover:not(:disabled) { background: var(--accent-bright); box-shadow: 0 0 20px var(--accent-glow); }
  .pg-verify:disabled { opacity: 0.6; cursor: default; }

  .pg-body { display: grid; grid-template-columns: 1fr 1fr; min-height: 320px; }
  .pg-editor { border-right: 1px solid var(--border-subtle); display: flex; flex-direction: column; }
  .pg-editor-bar { display: flex; align-items: center; gap: var(--sp-3); padding: 10px var(--sp-4); border-bottom: 1px solid var(--border-subtle); background: var(--bg-inset); }
  .pg-editor-bar .dots { display: flex; gap: 6px; } .pg-editor-bar .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .pg-filename { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-muted); }
  #pg-code { width: 100%; flex: 1; resize: none; border: none; outline: none; background: var(--bg-inset);
    color: var(--text-primary); font-family: var(--font-mono); font-size: var(--fs-small); line-height: 1.8;
    padding: var(--sp-4); tab-size: 2; overflow: hidden; }

  .pg-output { background: var(--bg-base); padding: var(--sp-6); display: flex; flex-direction: column; justify-content: center; }
  .pg-idle { text-align: center; color: var(--text-muted); }
  .pg-idle-mark { font-family: var(--font-mono); font-size: 2rem; color: var(--border-strong); display: block; margin-bottom: var(--sp-3); }
  .pg-idle p { font-size: var(--fs-small); } .pg-idle b { color: var(--text-secondary); }

  .pg-running { font-family: var(--font-mono); font-size: var(--fs-small); color: var(--text-muted); display: flex; align-items: center; gap: var(--sp-3); justify-content: center; }
  .pg-spin { width: 14px; height: 14px; border: 2px solid var(--border-strong); border-top-color: var(--accent); border-radius: 50%; animation: pg-spin 0.7s linear infinite; }
  @keyframes pg-spin { to { transform: rotate(360deg); } }

  .pg-result { width: 100%; }
  .pg-r-head { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-4); flex-wrap: wrap; }
  .pg-r-count { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-muted); }
  .pg-guarantee { font-size: var(--fs-small); color: var(--accent-bright); background: var(--state-verified-bg);
    border: 1px solid var(--accent-dim); border-radius: var(--r-md); padding: var(--sp-4); box-shadow: var(--elev-glow); }
  .pg-r-foot { font-size: var(--fs-small); color: var(--text-muted); margin-top: var(--sp-4); }

  .pg-cx { background: var(--bg-inset); border: 1px solid rgba(244,85,78,0.3); border-radius: var(--r-md); padding: var(--sp-4); display: grid; gap: var(--sp-2); }
  .pg-cx-row { display: flex; gap: var(--sp-3); align-items: baseline; font-family: var(--font-mono); font-size: var(--fs-caption); }
  .pg-cx-k { color: var(--text-faint); width: 64px; flex-shrink: 0; text-transform: uppercase; letter-spacing: 0.08em; }
  .pg-cx-row code { color: var(--text-primary); }
  .pg-violate { color: var(--state-counter) !important; }

  .pg-disclaimer { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-faint); margin-top: var(--sp-4); text-align: center; }

  @media (max-width: 820px) {
    .pg-body { grid-template-columns: 1fr; }
    .pg-editor { border-right: none; border-bottom: 1px solid var(--border-subtle); }
    .pg-toolbar { justify-content: center; }
  }
</style>
