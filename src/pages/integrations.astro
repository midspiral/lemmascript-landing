---
import BaseLayout from '../layouts/BaseLayout.astro'

// status: 'available' | 'preview' | 'planned'  — adjust to reflect reality
const editors = [
  { name: 'VS Code', status: 'preview', desc: 'Inline verification status in the gutter, counterexamples surfaced at the failing line, and autocomplete for //@ annotations.' },
  { name: 'Neovim', status: 'planned', desc: 'An LSP client integration exposing verify-on-save and obligation diagnostics directly in the buffer.' },
  { name: 'JetBrains', status: 'planned', desc: 'WebStorm / IntelliJ plugin bringing the same inline proof feedback to the JetBrains family.' },
]

const agents = [
  { name: 'Claude Code', status: 'available', desc: 'Run the verify loop as a tool the agent can call — it reads counterexamples and iterates until the code is proved correct.' },
  { name: 'Cursor / Windsurf', status: 'preview', desc: 'Expose LemmaScript as a command the editor-agent invokes after each edit, closing the generate → verify → fix loop.' },
  { name: 'GitHub Actions', status: 'available', desc: 'A CI action that fails the build on any unproved obligation, so verification is enforced on every pull request.' },
  { name: 'CLI', status: 'available', desc: 'lemmascript verify runs anywhere — local pre-commit hooks, scripts, or any CI system that runs a shell.' },
]

const extend = [
  { name: 'Proof backends', desc: 'Lean 4 and Dafny ship in the box. The backend interface is designed to admit additional provers over time.' },
  { name: 'Annotation packs', desc: 'Bundle reusable specification helpers and domain predicates so teams can share a common vocabulary of contracts.' },
  { name: 'Domain verifiers', desc: 'Layer specialized checks — concurrency, units, state machines — on top of the core verification engine.' },
]

const label = { available: 'Available', preview: 'Tech preview', planned: 'Planned' }
const badgeClass = { available: 'badge-verified', preview: 'badge-info', planned: 'badge-pending' }
---

<BaseLayout
  title="Integrations — LemmaScript"
  description="How LemmaScript fits your stack: editor and IDE plugins, coding-agent and CI integrations, and an extensible backend and annotation API."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// integrations</span>
      <h1>LemmaScript fits the tools you <em>already use</em>.</h1>
      <p class="lede">
        Verification is only useful where you work. LemmaScript plugs into your editor, your coding
        agent, and your CI — and exposes an API for building on top of the engine itself.
      </p>
    </div>
  </header>

  <!-- editors -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// editors &amp; IDEs</span>
        <h2>See proofs where you write code</h2>
        <p class="section-desc">Verification status, counterexamples, and annotation assistance, inline in your editor.</p>
      </div>
      <div class="int-grid">
        {editors.map((e) => (
          <div class="card int-card">
            <div class="int-top">
              <h3>{e.name}</h3>
              <span class={`badge ${badgeClass[e.status]}`}><span class="bdot"></span>{label[e.status]}</span>
            </div>
            <p>{e.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- agents & CI -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// agents &amp; CI</span>
        <h2>Close the generate → verify → fix loop</h2>
        <p class="section-desc">LemmaScript is built for autonomous workflows — give an agent the toolchain and let it prove its own output.</p>
      </div>
      <div class="int-grid">
        {agents.map((a) => (
          <div class="card int-card">
            <div class="int-top">
              <h3>{a.name}</h3>
              <span class={`badge ${badgeClass[a.status]}`}><span class="bdot"></span>{label[a.status]}</span>
            </div>
            <p>{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- extension api -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// extend it</span>
        <h2>An engine you can build on</h2>
        <p class="section-desc">The core is extensible by design — backends, annotation packs, and domain-specific verifiers.</p>
      </div>
      <div class="ext-grid">
        {extend.map((x) => (
          <div class="ext">
            <h3>{x.name}</h3>
            <p>{x.desc}</p>
          </div>
        ))}
      </div>
      <div class="callout callout-warn" style="margin-top:var(--sp-8)">
        <span class="mark">!</span>
        <div><b>Tech preview.</b> The plugin and backend APIs are still stabilizing. Status labels above reflect current availability and will move toward <b style="color:var(--state-verified)">Available</b> as the preview matures.</div>
      </div>
      <div class="center" style="margin-top:var(--sp-12)">
        <a href="https://docs.lemmascript.com" target="_blank" rel="noopener" class="btn btn-primary">Integration docs →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .int-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
  .int-card { display: flex; flex-direction: column; gap: var(--sp-3); }
  .int-top { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); }
  .int-card h3 { font-size: var(--fs-h3); }
  .int-card p { font-size: var(--fs-small); }

  .ext-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .ext { padding: var(--sp-6); border-left: 2px solid var(--accent-dim); }
  .ext h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-2); }
  .ext p { font-size: var(--fs-small); }

  @media (max-width: 860px) {
    .int-grid, .ext-grid { grid-template-columns: 1fr; }
  }
</style>
