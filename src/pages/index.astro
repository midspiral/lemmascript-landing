---
import BaseLayout from '../layouts/BaseLayout.astro'

const evidence = [
  { kind: 'Brownfield', metric: '4 CVEs', name: 'hono-lemmascript', desc: 'Security-critical middleware in a fork of Hono, hardened against four real CVEs — IP restriction, cookies, path traversal.', href: 'https://github.com/midspiral/hono-lemmascript' },
  { kind: 'Brownfield', metric: '11 functions', name: 'opencode-lemmascript', desc: 'A fork of opencode with its permission system locked down — eleven access-control functions guaranteed to honor their contracts.', href: 'https://github.com/midspiral/opencode-lemmascript' },
  { kind: 'Greenfield', metric: 'No overbooking', name: 'quota-lemmascript', desc: 'A booking app whose allocation logic is guaranteed incapable of overbooking — no matter the inputs.', href: 'https://github.com/midspiral/quota-lemmascript' },
]
---

<BaseLayout
  title="LemmaScript — agent-first contracts for TypeScript"
  description="LemmaScript adds contracts to TypeScript so your agents build code that's correct by construction — and you can review it at a glance. No new language, no runtime cost."
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="container hero-full">
        <span class="hero-eyebrow">// built for agents</span>
        <h1 class="hero-title">LemmaScript is TypeScript with syntax for <span class="pos-contracts">contracts</span>.</h1>
        <div class="hero-code">
          <div class="codeblock">
            <div class="code-bar"><span class="code-file">core.verified.ts</span><a class="code-src" href="https://github.com/midspiral/hono-rate-limiter-with-lemmascript/blob/main/src/core.verified.ts#L38-L57" target="_blank" rel="noopener">// real code ↗</a><span class="badge badge-verified" style="margin-left:auto"><span class="bdot"></span>Guaranteed</span></div>
            <pre class="code-body"><span class="ln">43</span><span class="t-cmt">// keep only the requests still inside the time window</span>
<span class="ln">44</span><span class="t-kw">export</span> <span class="t-kw">function</span> <span class="t-fn">pruneWindow</span>(log: <span class="t-kw">number</span>[], now: <span class="t-kw">number</span>, W: <span class="t-kw">number</span>): <span class="t-kw">number</span>[] &#123;
<span class="ln">45</span>  <span class="t-anno">//@ requires</span> <span class="t-annokw">forall(k, 0 &lt;= k &amp;&amp; k &lt; log.length ==&gt; log[k] &lt;= now)</span>
<span class="ln">46</span>  <span class="t-anno">//@ decreases</span> <span class="t-annokw">log.length</span>
<span class="ln">47</span>  <span class="t-anno">//@ ensures</span> <span class="t-annokw">\result.length &lt;= log.length</span>
<span class="ln">48</span>  <span class="t-anno">//@ ensures</span> <span class="t-annokw">forall(k, 0 &lt;= k &amp;&amp; k &lt; \result.length ==&gt; now - W &lt; \result[k] &amp;&amp; \result[k] &lt;= now)</span>
<span class="ln">49</span>  <span class="t-kw">if</span> (log.length === <span class="t-num">0</span>) &#123;
<span class="ln">50</span>    <span class="t-kw">return</span> [];
<span class="ln">51</span>  &#125;
<span class="ln">52</span>  <span class="t-kw">const</span> rest = <span class="t-fn">pruneWindow</span>(log.slice(<span class="t-num">1</span>), now, W);
<span class="ln">53</span>  <span class="t-kw">if</span> (log[<span class="t-num">0</span>] &gt; now - W) &#123;
<span class="ln">54</span>    <span class="t-kw">return</span> [log[<span class="t-num">0</span>], ...rest];
<span class="ln">55</span>  &#125;
<span class="ln">56</span>  <span class="t-kw">return</span> rest;
<span class="ln">57</span>&#125;</pre>
          </div>
        </div>
        <div class="hero-actions">
          <a href="/try" class="btn btn-primary">Try it live →</a>
          <a href="https://docs.lemmascript.com" target="_blank" rel="noopener" class="btn btn-secondary">Read the docs</a>
        </div>
    </div>
  </section>

  <!-- ===================== CAUGHT IN THE ACT ===================== -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto">
        <span class="kicker">// caught in the act</span>
        <h2>The agent wrote buggy TypeScript. <br /> LemmaScript's contract caught it. <br /> The agent fixed it before surfacing the code.</h2>
        <p class="section-desc">While splitting 10 three ways, the agent’s first attempt floored each share and called it done. It looked right, but a cent vanished. The contract said the parts <i>must sum to the whole</i>, so the implementation was rejected. The agent got the rejection feedback from the verifier and shipped the fix.</p>
      </div>

      <div class="catch-grid">
        <!-- WRONG -->
        <div class="catch-col">
          <div class="catch-head"><span class="badge badge-counter">Rejected</span><span class="catch-label">the agent’s first try</span></div>
          <div class="codeblock catch-bad">
            <div class="code-bar"><span class="code-file">allocateNaive.ts</span><a class="code-src" href="https://github.com/midspiral/eventab-lemmascript/blob/main/src/allocateNaive.ts#L36" target="_blank" rel="noopener">// real code ↗</a></div>
            <pre class="code-body"><span class="t-anno">//@ ensures</span> <span class="t-annokw">sum(result) === total</span>  <span class="t-cmt">// must sum to the whole</span>
<span class="t-kw">function</span> <span class="t-fn">allocateNaive</span>(total, weights) &#123;
  <span class="t-kw">const</span> W = <span class="t-fn">sum</span>(weights);
  <span class="t-kw">return</span> weights.map(w =&gt;
    Math.floor(total * w / W));  <span class="t-cmt">// floor each share, ship</span>
&#125;</pre>
          </div>
          <p class="catch-note bad">allocate(10, [1,1,1]) → [3,3,3] · that’s 9, not 10 — a cent vanished.</p>
        </div>

        <!-- FIXED -->
        <div class="catch-col">
          <div class="catch-head"><span class="badge badge-verified">Guaranteed</span><span class="catch-label">the agent’s fix</span></div>
          <div class="codeblock catch-ok">
            <div class="code-bar"><span class="code-file">allocate.ts</span><a class="code-src" href="https://github.com/midspiral/eventab-lemmascript/blob/main/src/allocate.ts#L49" target="_blank" rel="noopener">// real code ↗</a></div>
            <pre class="code-body"><span class="t-anno">//@ ensures</span> <span class="t-annokw">sum(result) === total</span>  <span class="t-cmt">// must sum to the whole</span>
<span class="t-kw">function</span> <span class="t-fn">allocate</span>(total, weights) &#123;
  <span class="t-kw">const</span> W = <span class="t-fn">sum</span>(weights);
  <span class="t-kw">const</span> result = weights.map(w =&gt; Math.floor(total * w / W));
  <span class="t-kw">let</span> left = total - <span class="t-fn">sum</span>(result);  <span class="t-cmt">// the leftover, lost to flooring</span>
  <span class="t-kw">for</span> (<span class="t-kw">let</span> k = <span class="t-num">0</span>; left &gt; <span class="t-num">0</span>; k++, left--)
    result[k] += <span class="t-num">1</span>;           <span class="t-cmt">// hand them back out</span>
  <span class="t-kw">return</span> result;
&#125;</pre>
          </div>
          <p class="catch-note">Hands the leftover back out — now every cent is accounted for.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== REVIEW SPECS, NOT IMPLEMENTATION ===================== -->
  <section class="section section-alt review">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto">
        <span class="kicker">// review intent, not implementation</span>
        <h2>You review the spec. The agent writes the rest.</h2>
        <p class="section-desc">A few declarative contracts say exactly what the code must do. The implementation that satisfies them is the agent’s job — you don’t have to read it.</p>
      </div>
      <div class="review-grid">
        <div class="review-col review-spec">
          <div class="review-label"><span class="badge badge-verified"><span class="bdot"></span>What you review</span><span class="review-meta">the spec · 4 lines</span></div>
          <div class="codeblock">
            <div class="code-bar"><span class="code-file">binarySearch.ts</span><a class="code-src" href="https://github.com/midspiral/LemmaScript/blob/main/examples/binarySearch.ts" target="_blank" rel="noopener">// real code ↗</a></div>
            <pre class="code-body"><span class="t-cmt">// find target in a sorted array, or -1</span>
<span class="t-anno">//@ requires</span> <span class="t-annokw">sorted(arr)</span>
<span class="t-anno">//@ ensures</span>  <span class="t-annokw">\result &gt;= 0 ==&gt; arr[\result] === target</span>
<span class="t-anno">//@ ensures</span>  <span class="t-annokw">\result === -1 ==&gt; forall(k, arr[k] !== target)</span></pre>
          </div>
          <p class="review-note">Read it in seconds. This is the whole guarantee.</p>
        </div>

        <div class="review-col review-impl">
          <div class="review-label"><span class="review-meta">what the agent writes · a while-loop with 6 invariants</span></div>
          <div class="codeblock">
            <div class="code-bar"><span class="code-file">binarySearch.ts</span></div>
            <pre class="code-body impl-dim">export function binarySearch(arr: number[], target: number): number &#123;
  let lo = 0;
  let hi = arr.length - 1;
  let result = -1;

  while (lo &lt;= hi) &#123;
    //@ invariant 0 &lt;= lo &amp;&amp; lo &lt;= arr.length
    //@ invariant -1 &lt;= hi &amp;&amp; hi &lt; arr.length
    //@ invariant forall(k, 0 &lt;= k &amp;&amp; k &lt; lo ==&gt; arr[k] !== target)
    //@ invariant forall(k, hi &lt; k &amp;&amp; k &lt; arr.length ==&gt; arr[k] !== target)
    //@ invariant result === -1 || (result &gt;= 0 &amp;&amp; arr[result] === target)
    //@ decreases (hi - lo + 1)

    const mid = Math.floor((lo + hi) / 2);
    if (arr[mid] === target) &#123;
      result = mid;
      break;
    &#125; else if (arr[mid] &lt; target) &#123;
      lo = mid + 1;
    &#125; else &#123;
      hi = mid - 1;
    &#125;
  &#125;
  return result;
&#125;</pre>
          </div>
          <p class="review-note">Famously easy to get subtly wrong — and a pain to test. You don’t read it; the spec already says what it does.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== EVIDENCE ===================== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// in the wild</span>
        <h2>Not a toy. Real code, guaranteed correct.</h2>
        <p class="section-desc">LemmaScript has been put to work on production-grade software and greenfield builds — each one guaranteed correct, from the TypeScript you already write.</p>
      </div>
      <div class="ev-grid">
        {evidence.map((e) => (
          <a href={e.href} target="_blank" rel="noopener" class="card ev-card">
            <span class:list={['ev-kind', { brown: e.kind === 'Brownfield' }]}>{e.kind}</span>
            <div class="ev-metric">{e.metric}</div>
            <h3>{e.name}</h3>
            <p>{e.desc}</p>
            <span class="ev-link">View repository →</span>
          </a>
        ))}
      </div>
      <div class="center" style="margin-top:var(--sp-8)"><a href="/case-studies" class="link-arrow">See all case studies →</a></div>
    </div>
  </section>

  <!-- ===================== GET STARTED ===================== -->
  <section class="section section-alt">
    <div class="container two-col">
      <div>
        <span class="kicker">// get started</span>
        <h2>Add your first contract in minutes.</h2>
        <p class="section-desc">Add LemmaScript to a project, write a contract on a function, and you’re done. Greenfield or an existing codebase — adopt it exactly as far as you want.</p>
        <div class="hero-actions">
          <a href="https://docs.lemmascript.com" target="_blank" rel="noopener" class="btn btn-primary">Read the quickstart →</a>
          <a href="https://github.com/midspiral/LemmaScript" target="_blank" rel="noopener" class="btn btn-secondary">View on GitHub</a>
        </div>
      </div>
      <div class="codeblock">
        <div class="code-bar"><span class="code-file">terminal</span></div>
        <pre class="code-body"><span class="t-cmt"># add LemmaScript to your project</span>
<span class="t-anno">$</span> npm install -D lemmascript

<span class="t-cmt"># check your code against its contracts</span>
<span class="t-anno">$</span> npx lemmascript check src/

<span class="t-kw">✓</span> charge   correct
<span class="t-kw">✓</span> refund   correct
<span class="t-cmt">2 / 2 correct · 1.2s</span></pre>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: var(--sp-24) var(--sp-16); }
  .hero-full { text-align: center; max-width: 1040px; margin-inline: auto; }
  .hero-eyebrow { display: inline-block; font-family: var(--font-mono); font-size: var(--fs-small);
    letter-spacing: 0.02em; color: var(--accent); margin-bottom: var(--sp-6); }
  .hero-title { font-size: clamp(1.6rem, 6vw, 3.1rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1.12; margin-bottom: var(--sp-6); text-wrap: balance; }
  .hero-title .pos-contracts { color: var(--accent); }
  .hero-code { max-width: 960px; margin: 0 auto var(--sp-8); text-align: left; }
  .hero-code .code-body { line-height: 1.85; }
  .code-src { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-faint); transition: color var(--dur-1) var(--ease); }
  .code-src:hover { color: var(--accent); }
  .hero-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; justify-content: center; }

  /* ---------- two-col (get started) ---------- */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-16); align-items: center; }
  .two-col h2 { margin: var(--sp-3) 0; }
  .two-col .hero-actions { justify-content: flex-start; }

  /* ---------- evidence ---------- */
  .ev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .ev-card { display: flex; flex-direction: column; }
  .ev-kind { font-family: var(--font-mono); font-size: var(--fs-caption); text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); }
  .ev-kind.brown { color: var(--state-pending); }
  .ev-metric { font-family: var(--font-display); font-size: var(--fs-h2); font-weight: 700; color: var(--text-primary); letter-spacing: -0.02em; margin: var(--sp-2) 0; }
  .ev-card h3 { font-family: var(--font-mono); font-weight: 600; font-size: var(--fs-body); color: var(--accent-bright); margin-bottom: var(--sp-2); }
  .ev-card p { font-size: var(--fs-small); margin-bottom: var(--sp-4); }
  .ev-link { margin-top: auto; font-size: var(--fs-small); color: var(--text-muted); }
  .ev-card:hover .ev-link { color: var(--accent); }

  /* ---------- review specs vs implementation ---------- */
  .review-grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: var(--sp-6); align-items: start; }
  .review-col { min-width: 0; }
  .review-col .codeblock { min-width: 0; }
  .review-label { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-3); min-height: 26px; }
  .review-meta { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-muted); }
  .review-spec .codeblock { box-shadow: var(--elev-glow); }
  .review-grid .code-body { overflow: hidden; }
  .review-spec .code-body { line-height: 2; }
  .review-impl .code-body { font-size: 0.75rem; line-height: 1.7; }
  .impl-dim { color: var(--text-muted); opacity: 0.7; white-space: pre; }
  .review-note { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-faint); margin-top: var(--sp-3); }

  @media (max-width: 860px) { .review-grid { grid-template-columns: 1fr; } }

  /* ---------- caught in the act ---------- */
  .catch-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-6); align-items: start; }
  .catch-grid > * { min-width: 0; }
  .catch-head { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-3); }
  .catch-label { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .catch-bad { border-color: rgba(244,85,78,0.35); }
  .catch-ok { border-color: var(--accent-dim); box-shadow: var(--elev-glow); }
  .catch-col .code-body { font-size: var(--fs-caption); line-height: 1.7; }
  .catch-note { font-size: var(--fs-small); color: var(--text-muted); margin-top: var(--sp-3); }
  .catch-note.bad { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--state-counter); }
  @media (max-width: 860px) { .catch-grid { grid-template-columns: 1fr; } }

  @media (max-width: 900px) {
    .two-col { grid-template-columns: 1fr; gap: var(--sp-12); }
    .ev-grid { grid-template-columns: 1fr; }
  }
</style>
