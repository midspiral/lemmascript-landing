---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Web apps — LemmaScript Solutions"
  description="The business logic in a web app that has to be right for every request — allocation, counting, state transitions — made correct by construction with LemmaScript contracts."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// solutions / web apps</span>
      <h1>Core logic that holds <em>under any load.</em></h1>
      <p class="lede">
        The parts of a web app that break in the costliest ways aren't the UI — they're
        the invariants underneath it: how many slots are left, whether this booking fits,
        what the total actually is. LemmaScript makes that logic correct by construction.
      </p>
    </div>
  </header>

  <!-- CONTRACT IN ACTION -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// contract in action</span>
        <h2>The same code — with a guarantee that travels with it.</h2>
        <p class="section-desc">
          A contract pinned to the function that carries the critical invariant. The agent
          iterates until the code satisfies it for every possible input.
        </p>
      </div>
      <div class="code-compare">
        <div class="codeblock">
          <div class="code-bar">
            <span class="code-file">src/domain.ts</span>
            <span class="code-label">before</span>
          </div>
          <pre class="code-body"><span class="t-cmt">// counting logic — no guarantee on what it returns</span>
<span class="t-kw">export function</span> <span class="t-fn">hasRoom</span>(p: Page, idx: number): boolean &#123;
  <span class="t-kw">return</span> confirmedCount(p.bookings, idx) &lt; capacityAt(p.slots, idx)
&#125;</pre>
        </div>
        <div class="compare-arrow" aria-hidden="true">→</div>
        <div class="codeblock compare-after">
          <div class="code-bar">
            <span class="code-file">src/domain.ts</span>
            <span class="badge badge-verified" style="margin-left:auto">Guaranteed</span>
          </div>
          <pre class="code-body"><span class="t-cmt">// same code — contract pins exactly what it must return</span>
<span class="t-kw">export function</span> <span class="t-fn">hasRoom</span>(p: Page, idx: number): boolean &#123;
  <span class="t-anno">//@ ensures \result === (</span>
  <span class="t-anno">//@   0 &lt;= idx &amp;&amp; idx &lt; p.slots.length &amp;&amp;</span>
  <span class="t-anno">//@   confirmedCount(p.bookings, idx) &lt; capacityAt(p.slots, idx)</span>
  <span class="t-anno">//@ )</span>
  <span class="t-kw">return</span> confirmedCount(p.bookings, idx) &lt; capacityAt(p.slots, idx)
&#125;</pre>
        </div>
      </div>
      <p class="code-caption">
        From <a href="https://github.com/midspiral/quota-lemmascript" target="_blank" rel="noopener" class="link-arrow">quota-lemmascript ↗</a>
      </p>
    </div>
  </section>

  <!-- CONCURRENT REQUEST DIAGRAM -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// why it matters</span>
        <h2>The invariant holds regardless of how requests arrive.</h2>
        <p class="section-desc">
          A contract that's correct for every input is correct under concurrent load — no matter
          the order, the timing, or how many requests land at once.
        </p>
      </div>

      <div class="concur-diagram">
        <div class="concur-requests">
          <div class="concur-req">
            <span class="concur-label">Request A</span>
            <span class="concur-sub">books slot 3</span>
          </div>
          <div class="concur-req">
            <span class="concur-label">Request B</span>
            <span class="concur-sub">books slot 3</span>
          </div>
          <div class="concur-req concur-req-dim">
            <span class="concur-label">Request C</span>
            <span class="concur-sub">books slot 3</span>
          </div>
        </div>

        <div class="concur-arrow-col" aria-hidden="true">
          <span>↓</span><span>↓</span><span>↓</span>
        </div>

        <div class="concur-contract">
          <span class="concur-contract-title"><code class="t-anno">//@ ensures</code> never oversells</span>
          <span class="concur-contract-sub">holds for every input — any order, any timing</span>
        </div>

        <div class="concur-arrow-col" aria-hidden="true">
          <span class="t-anno">↓</span>
        </div>

        <div class="concur-outcomes">
          <div class="concur-out concur-out-ok">
            <span class="concur-out-badge badge badge-verified"><span class="bdot"></span>Confirmed</span>
            <span class="concur-out-sub">Request A — slot had room</span>
          </div>
          <div class="concur-out concur-out-ok">
            <span class="concur-out-badge badge badge-verified"><span class="bdot"></span>Confirmed</span>
            <span class="concur-out-sub">Request B — slot had room</span>
          </div>
          <div class="concur-out concur-out-rej">
            <span class="concur-out-badge badge badge-counter"><span class="bdot"></span>Rejected</span>
            <span class="concur-out-sub">Request C — slot was full</span>
          </div>
        </div>
      </div>

      <p class="diagram-note">Confirmed means it fit. Rejected means it didn't. Neither outcome can be wrong.</p>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// what you get</span>
        <h2>Invariants that can't be broken.</h2>
      </div>
      <div class="what-grid">
        <div class="what-item">
          <h3>Correct under concurrency</h3>
          <p>A contract that holds for every input holds regardless of arrival order — the formal license for lock-free, multi-device designs.</p>
        </div>
        <div class="what-item">
          <h3>Safe to refactor</h3>
          <p>The guarantee travels with the code. A future refactor that breaks the invariant fails the check immediately — not in production weeks later.</p>
        </div>
        <div class="what-item">
          <h3>One core, any platform</h3>
          <p>A verified core in ordinary TypeScript runs in the browser, on the server, and on the edge — no second implementation to drift out of sync.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- EXAMPLE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// example</span>
        <h2>A booking app that can't overbook — by construction.</h2>
        <p class="section-desc">
          Quota lets providers publish a limited number of slots and users claim them.
          Its core allocation logic is guaranteed never to oversell — no matter how
          many people book at once, or in what order.
        </p>
      </div>
      <div class="ex-stats">
        <div class="ex-stat">
          <span class="ex-val">0</span>
          <span class="ex-label">chance of overselling a slot</span>
        </div>
        <div class="ex-stat">
          <span class="ex-val">order</span>
          <span class="ex-label">invariant — timing can't corrupt counts</span>
        </div>
        <div class="ex-stat">
          <span class="ex-val">1</span>
          <span class="ex-label">verified core, browser + edge</span>
        </div>
      </div>
      <div class="ex-actions">
        <a href="/case-studies/quota" class="btn btn-primary">Read the case study →</a>
        <a href="/solutions" class="btn btn-secondary">All solutions</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* before/after code compare */
  .code-compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--sp-4);
    align-items: center;
    margin-bottom: var(--sp-4);
  }
  .compare-arrow {
    font-size: 1.5rem;
    color: var(--accent);
    font-family: var(--font-mono);
    text-align: center;
    padding: 0 var(--sp-2);
  }
  .compare-after { box-shadow: 0 0 0 1px var(--accent-dim), var(--elev-glow); }
  .code-label {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-left: auto;
  }
  .code-caption {
    font-size: var(--fs-caption);
    color: var(--text-faint);
    font-family: var(--font-mono);
  }

  /* concurrency diagram */
  .concur-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-10) 0;
  }
  .concur-requests {
    display: flex;
    gap: var(--sp-4);
  }
  .concur-req {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-1);
    padding: var(--sp-4) var(--sp-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
    min-width: 120px;
  }
  .concur-req-dim { opacity: 0.55; }
  .concur-label { font-family: var(--font-mono); font-size: var(--fs-small); font-weight: 600; color: var(--text-primary); }
  .concur-sub { font-size: var(--fs-caption); color: var(--text-muted); }

  .concur-arrow-col {
    display: flex;
    gap: var(--sp-12);
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  .concur-contract {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-5) var(--sp-8);
    background: var(--state-verified-bg);
    border: 1px solid var(--accent-dim);
    border-radius: var(--r-lg);
    box-shadow: var(--elev-glow);
  }
  .concur-contract-title { font-family: var(--font-mono); font-size: var(--fs-small); font-weight: 600; color: var(--accent); }
  .concur-contract-sub { font-size: var(--fs-caption); color: var(--text-secondary); }

  .concur-outcomes {
    display: flex;
    gap: var(--sp-4);
  }
  .concur-out {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-4) var(--sp-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
    min-width: 120px;
  }
  .concur-out-sub { font-size: var(--fs-caption); color: var(--text-muted); text-align: center; }

  .diagram-note {
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-top: var(--sp-2);
  }

  /* shared */
  .what-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .what-item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); padding: var(--sp-6); }
  .what-item h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-3); }
  .what-item p { font-size: var(--fs-small); color: var(--text-secondary); line-height: 1.65; }

  .ex-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); margin-bottom: var(--sp-10); }
  .ex-stat { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); padding: var(--sp-6); }
  .ex-val { display: block; font-family: var(--font-mono); font-size: 2rem; font-weight: 700; color: var(--accent); margin-bottom: var(--sp-2); }
  .ex-label { font-size: var(--fs-small); color: var(--text-muted); }

  .ex-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }

  @media (max-width: 860px) {
    .code-compare { grid-template-columns: 1fr; }
    .compare-arrow { transform: rotate(90deg); }
    .what-grid, .ex-stats { grid-template-columns: 1fr; }
    .concur-requests, .concur-outcomes { flex-direction: column; align-items: center; }
    .concur-arrow-col { flex-direction: column; gap: 0; align-items: center; }
  }
</style>
