---
import BaseLayout from '../layouts/BaseLayout.astro'

const traits = [
  {
    title: 'Correct by construction',
    body: 'Every function Emira ships comes with a contract it can’t violate. There are no bugs to chase down later — correctness is built in from the first line.',
  },
  {
    title: 'Native, not bolted on',
    body: 'Correctness isn’t a tool Emira calls at the end. It’s how the code gets written — no prompt gymnastics, no retry-until-it-looks-right.',
  },
  {
    title: 'Reviewable in seconds',
    body: 'Emira emits plain TypeScript with declarative contracts. You review the intent at a glance, never the implementation.',
  },
]
---

<BaseLayout
  title="Emira — Coming soon | LemmaScript"
  description="Emira is the agent that writes correct-by-construction TypeScript natively. Join the waitlist for early access."
>
  <!-- ===================== HERO ===================== -->
  <section class="em-hero">
    <div class="container em-wrap">
      <span class="em-eyebrow">// coming soon</span>
      <h1 class="em-title">Meet <span class="em-name">Emira</span>.</h1>
      <p class="em-tag">The agent that writes correct TypeScript, guaranteed. <br />No duct-taped harnesses, no token-heavy workflows.  <br />
      <p class="em-lede">
        Emira doesn’t check correctness after the fact. It writes a contract and the code together,
        and emits a function only once it’s correct. 
      </p>

      <!-- waitlist -->
      <form class="em-form" id="em-form" novalidate>
        <input type="email" id="em-email" name="email" placeholder="you@company.com" autocomplete="email" aria-label="Email address" required />
        <button type="submit" class="btn btn-primary">Join the waitlist →</button>
      </form>
      <p class="em-formnote" id="em-note">Get early access to Emira</p>
    </div>
  </section>

  <!-- ===================== WHAT MAKES HER DIFFERENT ===================== -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto">
        <span class="kicker">// what makes it different</span>
        <h2>No guesswork. Correct on the first pass.</h2>
      </div>
      <div class="em-grid">
        {traits.map((t) => (
          <div class="card em-card">
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    // MailerLite embedded form — the form is bound to the emira-waitlist group
    // in the MailerLite dashboard (the endpoint is keyed by form, not group).
    const ML_ACCOUNT_ID = '1719612'
    const ML_FORM_ID = '193523581594895635'
    const form = document.getElementById('em-form')
    const note = document.getElementById('em-note')
    if (!form) return
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const email = document.getElementById('em-email')
      const button = form.querySelector('button[type="submit"]')
      const val = (email.value || '').trim()
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
        note.textContent = 'Please enter a valid email address.'
        note.style.color = 'var(--state-counter)'
        email.focus()
        return
      }
      button.disabled = true
      button.textContent = 'Joining…'
      try {
        const body = new FormData()
        body.append('fields[email]', val)
        body.append('ml-submit', '1')
        body.append('anticsrf', 'true')
        const res = await fetch(
          `https://assets.mailerlite.com/jsonp/${ML_ACCOUNT_ID}/forms/${ML_FORM_ID}/subscribe`,
          { method: 'POST', body }
        )
        const data = await res.json()
        if (!data.success) {
          const fieldErrors = data.errors && data.errors.fields
          const first = fieldErrors && Object.values(fieldErrors)[0]
          throw new Error(Array.isArray(first) ? first[0] : 'Subscription failed')
        }
        form.innerHTML = '<div class="em-success">Thanks!</div>'
        note.textContent = '✓ You’re on the list. We’ll be in touch.'
        note.style.color = 'var(--accent)'
      } catch (err) {
        button.disabled = false
        button.textContent = 'Join the waitlist →'
        note.textContent = (err && err.message) || 'Something went wrong — please try again in a moment.'
        note.style.color = 'var(--state-counter)'
      }
    })
  })()
</script>

<style>
  .em-hero { padding-block: var(--sp-24) var(--sp-16); }
  .em-wrap { max-width: 760px; margin-inline: auto; text-align: center; }
  .em-eyebrow { display: inline-block; font-family: var(--font-mono); font-size: var(--fs-small);
    letter-spacing: 0.02em; color: var(--accent); margin-bottom: var(--sp-6); }
  .em-title { font-size: clamp(2rem, 8vw, 4.5rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.02; margin-bottom: var(--sp-4); }
  .em-name { color: var(--accent); }
  .em-tag { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 500; color: var(--text-primary);
    letter-spacing: -0.01em; max-width: 60ch; margin: 0 auto var(--sp-4); line-height: 1.3; }
  .em-tag em { font-style: normal; color: var(--accent); }
  .em-lede { font-size: var(--fs-body-lg); color: var(--text-secondary); max-width: 56ch; margin: 0 auto var(--sp-8); }

  .em-form { display: flex; gap: var(--sp-3); justify-content: center; max-width: 480px; margin: 0 auto var(--sp-3); }
  .em-form input { flex: 1; min-width: 0; background: var(--bg-inset); border: 1px solid var(--border);
    border-radius: var(--r-md); color: var(--text-primary); font-family: var(--font-body); font-size: var(--fs-small);
    height: 42px; padding: 0 var(--sp-4); transition: border-color var(--dur-2) var(--ease); }
  .em-form input::placeholder { color: var(--text-faint); }
  .em-form input:focus { outline: none; border-color: var(--accent-dim); }
  .em-form .btn { flex-shrink: 0; }
  .em-formnote { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-muted); }
  .em-success { font-family: var(--font-mono); font-size: var(--fs-small); color: var(--accent);
    background: var(--state-verified-bg); border: 1px solid var(--accent-dim); border-radius: var(--r-md);
    padding: 11px var(--sp-4); }

  .em-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .em-card h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-2); }
  .em-card p { font-size: var(--fs-small); color: var(--text-secondary); }

  .em-teaser { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-16); align-items: center; }
  .em-teaser h2 { margin: var(--sp-3) 0; }
  .code-by { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--accent); }

  .em-cta { text-align: center; padding: var(--sp-16); box-shadow: var(--elev-glow); }
  .em-cta h2 { font-size: var(--fs-h1); margin-top: var(--sp-3); }

  @media (max-width: 860px) {
    .em-grid { grid-template-columns: 1fr; }
    .em-teaser { grid-template-columns: 1fr; gap: var(--sp-8); }
    .em-form { flex-direction: column; }
  }
</style>
