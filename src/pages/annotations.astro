---
import BaseLayout from '../layouts/BaseLayout.astro'

const annotations = [
  { tag: '//@ contract', kind: 'contract', sig: 'contract <prose>', desc: 'A natural-language statement of intent. Provers ignore it — it exists so the spec reads like a sentence, not just logic.', ex: 'Returns a value occurring in more than half of arr, or -1 if none.' },
  { tag: '//@ requires', kind: 'requires', sig: 'requires <expr>', desc: 'A precondition that must hold whenever the function is called. The caller is responsible for satisfying it; the function may rely on it.', ex: 'remaining >= 0 && cost >= 0' },
  { tag: '//@ ensures', kind: 'ensures', sig: 'ensures <expr>', desc: 'A postcondition the function guarantees on return. Use \\result to refer to the returned value.', ex: '\\result <= remaining' },
  { tag: '//@ invariant', kind: 'other', sig: 'invariant <expr>', desc: 'A loop invariant — a property that holds before the loop and after every iteration. The engine uses it to reason about unbounded loops.', ex: 'i >= 0 && sum == partial(i)' },
  { tag: '//@ decreases', kind: 'other', sig: 'decreases <expr>', desc: 'A termination measure: an expression that strictly decreases each iteration (or recursive call) and is bounded below — proving the code terminates.', ex: 'n - i' },
  { tag: '//@ assert', kind: 'other', sig: 'assert <expr>', desc: 'A condition that must hold at this exact program point. Useful for guiding LemmaScript or documenting intermediate facts.', ex: 'balance == credits - debits' },
  { tag: '//@ assume', kind: 'other', sig: 'assume <expr>', desc: 'A fact LemmaScript may take as given from this point forward. Use sparingly — assumptions are trust, not a guarantee.', ex: 'isValidated(input)' },
  { tag: '//@ pure', kind: 'other', sig: 'pure', desc: 'Treats a function as side-effect free so it may be referenced inside other specifications.', ex: '' },
  { tag: '//@ ghost', kind: 'other', sig: 'ghost <decl>', desc: 'Declares specification-only state used purely for reasoning. Ghost code is erased for runtime and never ships.', ex: 'let seen: Set<number>' },
]

const keywords = [
  { k: '\\result', d: 'The function’s return value, usable in ensures clauses.' },
  { k: '\\old(e)', d: 'The value of expression e on function entry (for mutation).' },
  { k: 'forall', d: 'Universal quantifier: forall(x, P(x)).' },
  { k: 'exists', d: 'Existential quantifier: exists(x, P(x)).' },
  { k: '==>', d: 'Logical implication.' },
  { k: '&&  ||  !', d: 'Conjunction, disjunction, negation.' },
]
---

<BaseLayout
  title="Annotations reference — LemmaScript"
  description="The complete LemmaScript contract reference: requires, ensures, invariant, decreases, assert, assume, pure, ghost, and the contract expression language."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// annotations</span>
      <h1>Contracts live in <em>comments</em>.</h1>
      <p class="lede">
        LemmaScript contracts are written entirely as TypeScript comments prefixed with
        <code class="inline">//@</code>. Your toolchain treats them as ordinary comments;
        LemmaScript treats them as a binding contract.
      </p>
    </div>
  </header>

  <!-- worked example -->
  <section class="section">
    <div class="container two-col">
      <div>
        <span class="kicker">// a worked example</span>
        <h2>One function under contract</h2>
        <p class="section-desc">Every clause below is checked against the implementation. Nothing about the running code changes.</p>
        <ul class="legend">
          <li><span class="dot pre"></span><b>requires</b> — what the caller must guarantee</li>
          <li><span class="dot post"></span><b>ensures</b> — what the function guarantees back</li>
          <li><span class="dot res"></span><code class="inline">\result</code> — the return value</li>
        </ul>
      </div>
      <div class="codeblock">
        <div class="code-bar"><span class="code-file">charge.ts</span><span class="badge badge-verified" style="margin-left:auto"><span class="bdot"></span>Guaranteed</span></div>
        <pre class="code-body"><span class="ln">1</span><span class="t-cmt">//</span><span class="t-at">@</span> <span class="t-dir-contract">contract</span> <span class="t-prose">Charges up to the remaining balance and never goes negative.</span>
<span class="ln">2</span><span class="t-cmt">//</span><span class="t-at">@</span> <span class="t-dir-requires">requires</span> <span class="t-annokw">remaining &gt;= 0 &amp;&amp; cost &gt;= 0</span>
<span class="ln">3</span><span class="t-cmt">//</span><span class="t-at">@</span> <span class="t-dir-ensures">ensures</span>  <span class="t-annokw">cost &lt;= remaining ==&gt; <span class="t-result">\result</span> === remaining - cost</span>
<span class="ln">4</span><span class="t-cmt">//</span><span class="t-at">@</span> <span class="t-dir-ensures">ensures</span>  <span class="t-annokw">cost &gt; remaining ==&gt; <span class="t-result">\result</span> === 0</span>
<span class="ln">5</span><span class="t-kw">function</span> <span class="t-fn">charge</span>(remaining: <span class="t-kw">number</span>, cost: <span class="t-kw">number</span>): <span class="t-kw">number</span> &#123;
<span class="ln">6</span>  <span class="t-kw">if</span> (cost &gt; remaining) <span class="t-kw">return</span> <span class="t-num">0</span>;
<span class="ln">7</span>  <span class="t-kw">return</span> remaining - cost;
<span class="ln">8</span>&#125;</pre>
      </div>
    </div>
  </section>

  <!-- reference table -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// reference</span>
        <h2>The contract clauses</h2>
      </div>
      <div class="anno-table">
        {annotations.map((a) => (
          <div class="anno-card">
            <div class={`anno-tag ${a.kind === 'other' ? 't-dir' : 't-dir-' + a.kind}`}>{a.tag}</div>
            <p class="anno-desc">{a.desc}</p>
            {a.ex && <code class="anno-ex">{a.tag} {a.ex}</code>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- expression language -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// expression language</span>
        <h2>Inside a contract</h2>
        <p class="section-desc">Contract expressions extend ordinary TypeScript with a few correctness-oriented constructs.</p>
      </div>
      <div class="kw-grid">
        {keywords.map((k) => (
          <div class="kw">
            <code class="kw-name">{k.k}</code>
            <span class="kw-desc">{k.d}</span>
          </div>
        ))}
      </div>
      <div class="callout callout-info" style="margin-top:var(--sp-8)">
        <span class="mark">i</span>
        <div><b>Editor-safe by design.</b> Because every contract is a comment, removing LemmaScript from a project leaves behind valid, unchanged TypeScript. There is no lock-in at the source level.</div>
      </div>
      <div class="center" style="margin-top:var(--sp-12)">
        <a href="https://docs.lemmascript.com" target="_blank" rel="noopener" class="btn btn-primary">Full documentation →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .inline { font-family: var(--font-mono); color: var(--accent-bright); font-size: 0.9em; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-16); align-items: center; }
  .two-col h2 { margin: var(--sp-3) 0; }

  .legend { list-style: none; margin-top: var(--sp-6); display: grid; gap: var(--sp-3); }
  .legend li { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--fs-small); color: var(--text-secondary); }
  .legend b { color: var(--text-primary); font-family: var(--font-mono); font-weight: 600; }
  .legend .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .legend .pre { background: var(--accent); }
  .legend .post { background: var(--accent-bright); }
  .legend .res { background: var(--state-info); }

  .anno-table { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
  .anno-card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); padding: var(--sp-6); }
  .anno-tag { font-family: var(--font-mono); font-size: var(--fs-body); }
  .anno-desc { font-size: var(--fs-small); margin: var(--sp-3) 0; }
  .anno-ex { display: block; font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-muted);
    background: var(--bg-inset); border: 1px solid var(--border-subtle); border-radius: var(--r-sm); padding: var(--sp-2) var(--sp-3); }

  .kw-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); }
  .kw { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-md); padding: var(--sp-4); }
  .kw-name { font-family: var(--font-mono); color: var(--accent-bright); font-weight: 600; display: block; margin-bottom: var(--sp-2); }
  .kw-desc { font-size: var(--fs-small); color: var(--text-secondary); }

  @media (max-width: 860px) {
    .two-col { grid-template-columns: 1fr; gap: var(--sp-8); }
    .anno-table, .kw-grid { grid-template-columns: 1fr; }
  }
</style>
