---
import BaseLayout from '../layouts/BaseLayout.astro'
import Playground from '../components/Playground.astro'
---

<BaseLayout
  title="Try it — LemmaScript"
  description="Edit a function and its contract in your browser and check it instantly — no install. See how LemmaScript holds code to its spec."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// try it</span>
      <h1>Check a contract, <em>live</em>.</h1>
      <p class="lede">
        Edit the code or its <code class="inline">//@</code> contract right here in your browser, hit Check, and
        watch LemmaScript hold it to the spec — no install, no signup.
      </p>
    </div>
  </header>

  <Playground />
</BaseLayout>

<style>
  .inline { font-family: var(--font-mono); color: var(--accent-bright); font-size: 0.9em; }
</style>
