---
import BaseLayout from '../layouts/BaseLayout.astro'

const greenfield = [
  { name: 'quota-lemmascript', href: 'https://github.com/midspiral/quota-lemmascript', backends: ['dafny'], desc: 'Booking app with formally verified core logic ensuring no overbooking. Deployable locally or on Cloudflare.' },
  { name: 'quorum-lemmascript', href: 'https://github.com/midspiral/quorum-lemmascript', backends: ['dafny'], desc: 'Login-free group scheduler with formally verified scheduling logic using Dafny proofs.' },
  { name: 'henri-lemmascript', href: 'https://github.com/midspiral/henri-lemmascript', backends: ['dafny'], desc: 'Coding-agent CLI with verified permissions, transcript handling, and hook merging logic across 48 verification conditions.' },
  { name: 'guardians-lemmascript', href: 'https://github.com/midspiral/guardians-lemmascript', backends: ['dafny'], desc: 'AI-agent workflow safety guardrails. Proves tainted data from sources never reaches sink parameters before execution.' },
  { name: 'collab-todo-lemmascript', href: 'https://github.com/midspiral/collab-todo-lemmascript/', backends: ['dafny'], desc: 'Collaborative task management app (React + Supabase) with a formally verified domain model in Dafny.' },
  { name: 'colorwheel-lemmascript', href: 'https://github.com/midspiral/colorwheel-lemmascript/', backends: ['dafny', 'lean'], desc: 'Verified color palette generator with mood and harmony constraints. 31 Lean proofs, 115 Dafny lemmas.' },
  { name: 'clear-split-lemmascript', href: 'https://github.com/midspiral/clear-split-lemmascript/', backends: ['dafny', 'lean'], desc: 'Verified expense-splitting web app. Conservation theorem, invariant preservation, and delta laws proven in both Lean and Dafny.' },
  { name: 'equality-game-lemmascript', href: 'https://github.com/midspiral/equality-game-lemmascript/', backends: ['dafny'], desc: 'Two-player arithmetic card game with verified core proving soundness and completeness of equality expression matching.' },
  { name: 'talktimer-lemmascript', href: 'https://github.com/midspiral/talktimer-lemmascript/', backends: ['dafny'], desc: 'React talk-timer app with verified domain logic — state invariants across 17 user actions, undo/redo history integrity.' },
  { name: 'github-star-checker-lemmascript', href: 'https://github.com/midspiral/github-star-checker-lemmascript/', backends: ['dafny'], desc: 'CLI tracking GitHub star counts with formally verified diff logic in Dafny via LemmaScript.' },
  { name: 'eventab-lemmascript', href: 'https://github.com/midspiral/eventab-lemmascript/', backends: ['dafny'], desc: 'Verified single-page group bill-splitter. Integer-cent allocation proves shares sum exactly to the tab and settlements net to zero.' },
  { name: 'eslint-plugin-with-lemmascript', href: 'https://github.com/midspiral/eslint-plugin-with-lemmascript', backends: ['dafny'], desc: 'ESLint plugin whose rule is a machine-checked theorem. no-forbidden-reach catches laundered cross-layer imports one-hop linters miss.' },
]

const brownfield = [
  { name: 'hono-lemmascript', href: 'https://github.com/midspiral/hono-lemmascript/blob/lemmascript/README_LemmaScript.md', backends: ['dafny'], desc: 'Fork of Hono with formally verified security-critical middleware against four CVEs — IP restrictions, cookies, and path traversal.' },
  { name: 'opencode-lemmascript', href: 'https://github.com/midspiral/opencode-lemmascript/blob/lemmascript/README_LemmaScript.md', backends: ['dafny'], desc: 'Fork of opencode with formal verification applied to its permission system and patch parser. Eleven functions verified.' },
  { name: 'charmchat', href: 'https://github.com/CHARM-BDF/charmchat/blob/lemma/README_LemmaScript.md', backends: ['dafny'], desc: 'AI agent orchestration backend — topological sort and provenance pipeline verified. 736 verification conditions, zero errors.' },
  { name: 'xyflow-lemmascript', href: 'https://github.com/midspiral/xyflow-lemmascript/blob/lemmascript/README_LemmaScript.md', backends: ['dafny'], desc: 'Fork of xyflow adding a verified DAG connection gate that rejects any cycle-closing edge, plus verified edge and geometry utilities.' },
  { name: 'rallly-lemmascript', href: 'https://github.com/midspiral/rallly-lemmascript/blob/lemmascript/README_LemmaScript.md', backends: ['dafny'], desc: 'Fork of Rallly meeting-poll app. Redirect-URL safety check and poll-scoring logic verified with zero errors.' },
  { name: 'pi-lemmascript', href: 'https://github.com/midspiral/pi-lemmascript/blob/lemmascript/README_LemmaScript.md', backends: ['dafny', 'lean'], desc: 'Agent harness context-compaction verified — proves tool results are never orphaned and tool-use runs stay intact.' },
  { name: 'balanced-match-lemmascript', href: 'https://github.com/midspiral/balanced-match-lemmascript/blob/lemmascript/README_LemmaScript.md', backends: ['dafny'], desc: 'Verified balanced-bracket finder (~70 lines, 1B+ npm downloads/month). Termination, endpoint bounds, and Dyck-balance proven.' },
  { name: 'node-casbin-lemmascript', href: 'https://github.com/midspiral/node-casbin-lemmascript/blob/lemmascript/README_LemmaScript.md', backends: ['dafny', 'lean'], desc: 'Verification of node-casbin access control library. 5 functions verified, 217 existing tests still pass.' },
]

const backendLabel = { dafny: 'Dafny', lean: 'Lean' }
---

<BaseLayout title="Case Studies — LemmaScript" description="Greenfield and brownfield projects formally verified with LemmaScript. From booking apps to production frameworks.">

  <section class="section">
    <div class="section-label">Case Studies</div>
    <h2>Greenfield &amp; brownfield projects, formally verified.</h2>
    <p class="section-desc">Each project uses annotated TypeScript as input and generates proofs via LemmaScript.</p>

    <h3 class="case-studies-heading">Greenfield</h3>
    <div class="cards-grid">
      {greenfield.map((cs) => (
        <a href={cs.href} target="_blank" rel="noopener" draggable={false} class="card">
          <div class="card-label greenfield">Greenfield{cs.backends.map((b) => <span class={`bk bk-${b}`}>{backendLabel[b]}</span>)}</div>
          <h3>{cs.name}</h3>
          <p>{cs.desc}</p>
        </a>
      ))}
    </div>

    <h3 class="case-studies-heading">Brownfield</h3>
    <div class="cards-grid">
      {brownfield.map((cs) => (
        <a href={cs.href} target="_blank" rel="noopener" draggable={false} class="card">
          <div class="card-label brownfield">Brownfield{cs.backends.map((b) => <span class={`bk bk-${b}`}>{backendLabel[b]}</span>)}</div>
          <h3>{cs.name}</h3>
          <p>{cs.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <p class="midspiral-note">
    LemmaScript is built by <a href="https://midspiral.com" target="_blank" rel="noopener">Midspiral</a> — the correctness layer for AI-generated software.
  </p>

</BaseLayout>
