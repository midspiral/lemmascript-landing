---
import BaseLayout from '../layouts/BaseLayout.astro'

const REPO = 'https://github.com/midspiral/LemmaScript'
const ISSUES = REPO + '/issues'
const GOOD_FIRST = ISSUES + '?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22'

// Three on-ramps, smallest to largest. Mirrors the "first time contributing? / jump
// right in" funnel: pick the path that matches the time you have.
const paths = [
  {
    h: 'Start small',
    p: 'A typo, a docs gap, a confusing error message. Open an issue or a pull request straight away — no setup or permission needed.',
    link: GOOD_FIRST,
    label: 'Good first issues →',
    external: true,
  },
  {
    h: 'Bring your own code',
    p: 'Point LemmaScript at a module you know well. Wherever it can’t express a property you care about, that gap is the contribution — open an issue with the case.',
    link: ISSUES,
    label: 'Report what you hit →',
    external: true,
  },
  {
    h: 'Go deep',
    p: 'Take on one of the known limits of what the toolchain can express. This is the highest-leverage work in the project. It also requires the most effort.',
    link: ISSUES,
    label: 'Browse the hard problems →',
    external: true,
  },
]

// What you can contribute to — the areas of the project, not the size of the task.
const areas = [
  { h: 'The language & compiler', p: 'The core toolchain: the contract language, what it can express, and the walls that still stand. Deep work, and the most leverage per line.' },
  { h: 'The ecosystem', p: 'Tools that snap onto the core — lint rules, editor helpers, CI surfaces, new pieces of the loop. Build the one you wish existed and submit it.' },
  { h: 'Errors & diagnostics', p: 'Anywhere the toolchain is confusing, unhelpful, or just wrong. If something surprised you or slowed you down, it’s worth an issue.' },
  { h: 'Docs & skills', p: 'If something took you or your AI agent longer to figure out than it should have, that’s a docs and/or skills gap. Fixes there help the next team move faster.' },
]

// LLM / agent policy — we're agent-first, so the rules are about ownership and
// guarantees, not about banning the tools.
const llmRules = [
  { h: 'Agent-driven implementation is okay; agent-driven thinking is not', p: 'Agent-implemented contributions are welcome. However, agents tend to overfit to the problem in front of them. The best improvements and fixes come from you zooming out and asking how to make this fix/feature broad enough to cover an entire class of issues rather than just one specific use case.' },
  { h: 'You alone are the author of record', p: 'Review and understand everything you submit regardless of who or what wrote it. If you can’t explain the change, or answer questions about it, it isn’t ready. Reviewer time is a scarce resource.' },
  { h: 'Never let an agent weaken a guarantee', p: 'The fastest way to make something pass is to relax a contract. Agents love to get to a green checkmark with this workaround. Triple check that your contribution is strengthening the system as a whole. Never trust an agent\'s word that it got to the result through the proper channels.' },
]

// Where it holds — real npm libraries whose core we shadow-verified against the pinned
// upstream source. `props` = contract properties proved; `checks` = randomized differential
// checks run against the real module to confirm the model matches its behavior. Numbers
// are from the actual runs.
const holds = [
  { lib: 'sorted-btree',      what: 'Leaf binary-search and insert — never drops a key or breaks sorted order.', props: '5 / 5', checks: '450,592' },
  { lib: 'compare-versions',  what: 'Semver comparison is a real total order — correct on every pair.',        props: '6 / 6', checks: '304,969' },
  { lib: 'p-queue',           what: 'Priority queue returns the right element on every dequeue; FIFO-stable.',   props: '6 / 6', checks: '174,623' },
  { lib: 'yaml',              what: 'Scalar/number round-trip on the verified core.',                           props: '5 / 5', checks: '59,006'  },
  { lib: 'rou3',              what: 'Static-route matching resolves to the correct handler.',                   props: '4 / 4', checks: '24,511'  },
  { lib: 'fast-json-patch',   what: 'compare / applyPatch / validate on flat object members.',                 props: '4 / 4', checks: '24,000'  },
]

// Where it breaks — honest limits, each a concrete place to start. Every wall is a real
// thing an lsc run hit on a real library.
// TODO: point each `issue` at the specific GitHub issue once filed.
const walls = [
  {
    title: 'Closures that capture and mutate outer state',
    body: 'A function that closes over and mutates a surrounding variable is dropped whole. This is what stops the Myers search loop in jsdiff and the fractional-index core in excalidraw.',
    issue: ISSUES,
  },
  {
    title: 'String-parsing internals',
    body: 'RegExp, parseInt, and toString semantics live outside the verifiable subset, and the spec surface has no substring slice (s[a..b]) yet — so string properties have to be re-derived pointwise. This is the wall behind cron-parser and the yaml scanner.',
    issue: ISSUES,
  },
  {
    title: 'Long-lived mutable object graphs',
    body: 'Shared, mutable references — copy-on-write B-tree internal nodes, a running statechart — are not in the fragment. The tractable leaf of sorted-btree verified; its recursive rebalancing did not.',
    issue: ISSUES,
  },
  {
    title: 'Real-number bounds',
    body: 'Floating-point arithmetic is only provable on an integer surrogate. Jitter like Math.round(Math.random() * delay) can be bounded on a floor model, not on the real value it actually computes.',
    issue: ISSUES,
  },
  {
    title: 'No user-space lemma mechanism',
    body: 'A proven //@ pure function cannot be invoked as a lemma from the TypeScript surface — its guarantees do not export, so induction helpers have to be written by hand in Dafny. Giving contracts a way to apply each other would unblock a whole class of proofs.',
    issue: ISSUES,
  },
]
---

<BaseLayout
  title="Contribute — LemmaScript"
  description="LemmaScript is young and built in the open. Pick your on-ramp — start small, bring your own code, or take a wall — and help shape how correct-by-construction software gets built."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// contribute</span>
      <h1>Built in the open.<br> <em>Good, bad, and ugly.</em></h1>
      <p class="lede">
        LemmaScript is young, and the ground floor is wide open. The people who show up
        now will shape how correct-by-construction software gets built — the language,
        the tools, and what agents can guarantee. Here's where it stands today, and where
        you come in.
      </p>
      <div class="head-actions">
        <a href={ISSUES} target="_blank" rel="noopener" class="btn btn-primary">Browse open issues</a>
      </div>
    </div>
  </header>

  <!-- START HERE -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// start here</span>
        <h2>First time contributing?</h2>
        <p class="section-desc">
          Welcome and thank you for your interest! Pick the on-ramp that matches the time you have; all
          three are real contributions.
        </p>
      </div>

      <div class="paths">
        {paths.map((p) => (
          <div class="path">
            <h3>{p.h}</h3>
            <p>{p.p}</p>
            <a class="link-arrow" href={p.link} {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}>{p.label}</a>
          </div>
        ))}
      </div>

      <div class="callout callout-info paths-note">
        <span class="mark">i</span>
        <div>
          <b>No gatekeeping.</b> A good bug report with a minimal reproduction is a real
          contribution on its own; you don't need to write the fix.
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT CAN I CONTRIBUTE TO -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// the map</span>
        <h2>What can I contribute to?</h2>
      </div>
      <div class="ways ways-4">
        {areas.map((w) => (
          <div class="way">
            <h3>{w.h}</h3>
            <p>{w.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LLMs & AGENTS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// agents &amp; LLMs</span>
        <h2>Using LLMs? Of course.</h2>
        <p class="section-desc">
          LemmaScript is built for a future where agents write the majority of the code. We're not going to ask you to leave yours at the door. The ground rules are about ownership and excellence, not the tools you use.
        </p>
      </div>
      <div class="ways ways-3">
        {llmRules.map((r) => (
          <div class="way">
            <h3>{r.h}</h3>
            <p>{r.p}</p>
          </div>
        ))}
      </div>

      <div class="agent-skill">
        <div class="agent-skill-head">
          <h3>Or let your agent contribute as it works</h3>
          <span class="badge badge-pending"><span class="bdot"></span>Coming soon</span>
        </div>
        <p>
          The special case to the rules above: a drop-in skill that turns everyday use into
          contributions. As your agent works with LemmaScript, it recognizes when it has hit
          a gap or a rough edge, files the issue on the spot, and — when the fix is within
          reach — submits the pull request itself. You stay the reviewer; the loop does the rest.
        </p>
      </div>
    </div>
  </section>

  <!-- WHERE IT HOLDS -->
  <!-- <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// where it holds</span>
        <h2>Verified against the real source.</h2>
        <p class="section-desc">
          So you know the ground you're building on: each of these takes the library at a
          pinned commit, models its core, and proves the listed properties. <em>Checks</em> is
          how many randomized inputs we then ran through both the model and the real module
          to confirm they agree — the proof is only meaningful if the thing proved matches
          the code that ships.
        </p>
      </div>

      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th>Library</th><th>What’s proved</th><th class="num">Properties</th><th class="num">Checks / failures</th></tr>
          </thead>
          <tbody>
            {holds.map((r) => (
              <tr>
                <td class="lib">{r.lib}</td>
                <td class="what">{r.what}</td>
                <td class="num props">{r.props}</td>
                <td class="num">{r.checks} / 0</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="foot-note">
        No <code>assume</code>, no <code>havoc</code>, no hand-axioms — the proofs stand on
        the code itself. Not everything went through cleanly: jsdiff, cron-parser, and
        excalidraw each got most of the way and then hit one of the walls below.
      </p>
    </div>
  </section> -->

  <!-- WHERE IT BREAKS -->
    <!-- <section class="section" id="walls">
      <div class="container">
        <div class="section-head">
          <span class="kicker">// help wanted</span>
          <h2>The walls we’re still working on.</h2>
          <p class="section-desc">
            These are real limits, each one hit by a real library. They’re also the best
            places to start — every one is a filed issue, and knocking one down unblocks
            everyone behind you.
          </p>
        </div>

        <ul class="walls">
          {walls.map((w) => (
            <li class="wall">
              <div class="wall-body">
                <h3>{w.title}</h3>
                <p>{w.body}</p>
              </div>
              <a class="wall-issue" href={w.issue} target="_blank" rel="noopener">Read the issue ↗</a>
            </li>
          ))}
        </ul>
      </div>
    </section> -->

  <!-- SHOWCASE -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// showcase</span>
        <h2>Built something with LemmaScript? Show it off.</h2>
        <p class="section-desc">
          The best proof this works is what people build with it. Ship a project with a
          contract-backed core — an app, a library, a tool — and submit it to the
          showcase. We feature the best ones on the site, with full credit to you.
        </p>
      </div>
      <div class="head-actions" style="margin-top: 0;">
        <a href={ISSUES} target="_blank" rel="noopener" class="btn btn-primary">Submit your project</a>
        <!-- <a href="/changelog" class="btn btn-secondary">See what others built</a> -->
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .head-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-8); }

  /* ---------- start-here paths ---------- */
  .paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .path {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-2);
    padding: var(--sp-6);
    background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg);
    transition: border-color var(--dur-2) var(--ease);
  }
  .path:hover { border-color: var(--accent-dim); }
  .path h3 { font-size: var(--fs-h3); margin: 0; }
  .path p { font-size: var(--fs-small); color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .path .link-arrow { margin-top: auto; padding-top: var(--sp-3); }

  .paths-note { margin-top: var(--sp-6); }
  .paths-note a { color: var(--accent); font-weight: 600; }
  .paths-note a:hover { color: var(--accent-bright); }

  /* ---------- data table ---------- */
  .table-wrap { overflow-x: auto; border: 1px solid var(--border-subtle); border-radius: var(--r-lg); }
  table.data { width: 100%; border-collapse: collapse; font-size: var(--fs-small); min-width: 640px; }
  table.data th, table.data td { text-align: left; padding: var(--sp-4) var(--sp-5); border-bottom: 1px solid var(--border-subtle); vertical-align: top; }
  table.data thead th { font-family: var(--font-mono); font-size: var(--fs-caption); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); font-weight: 600; background: var(--bg-inset); }
  table.data tbody tr:last-child td { border-bottom: 0; }
  table.data .lib { font-family: var(--font-mono); font-weight: 600; color: var(--text-primary); white-space: nowrap; }
  table.data .what { color: var(--text-secondary); line-height: 1.55; }
  table.data .num { font-family: var(--font-mono); text-align: right; white-space: nowrap; color: var(--text-muted); }
  table.data .props { color: var(--text-secondary); }
  .foot-note { margin-top: var(--sp-5); font-size: var(--fs-small); color: var(--text-muted); line-height: 1.65; max-width: 68ch; }
  .foot-note code { font-family: var(--font-mono); font-size: 0.92em; color: var(--text-secondary); }

  /* ---------- walls ---------- */
  .walls { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-3); }
  .wall { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--sp-6);
    padding: var(--sp-6); background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); }
  .wall-body { min-width: 0; }
  .wall h3 { font-size: var(--fs-h3); margin: 0 0 var(--sp-2); }
  .wall p { font-size: var(--fs-small); color: var(--text-secondary); line-height: 1.6; margin: 0; max-width: 74ch; }
  .wall-issue { flex-shrink: 0; font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-muted);
    white-space: nowrap; padding-top: 4px; transition: color var(--dur-1) var(--ease); }
  .wall-issue:hover { color: var(--accent); }

  /* ---------- areas ---------- */
  .ways { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
  .ways-3 { grid-template-columns: repeat(3, 1fr); }

  .agent-skill {
    margin-top: var(--sp-4);
    padding: var(--sp-6);
    background: var(--state-verified-bg);
    border: 1px solid var(--accent-dim);
    border-radius: var(--r-lg);
  }
  .agent-skill-head { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); flex-wrap: wrap; margin-bottom: var(--sp-2); }
  .agent-skill h3 { font-size: var(--fs-h3); margin: 0; }
  .agent-skill p { font-size: var(--fs-small); color: var(--text-secondary); line-height: 1.65; margin: 0; max-width: 80ch; }
  .ways-4 { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 1000px) {
    .ways-4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .ways-3 { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .ways-4 { grid-template-columns: 1fr; }
  }
  .way { padding: var(--sp-6); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); background: var(--bg-surface); }
  .way h3 { font-size: var(--fs-h3); margin: 0 0 var(--sp-2); }
  .way p { font-size: var(--fs-small); color: var(--text-secondary); line-height: 1.6; margin: 0; }

  .closing { max-width: 68ch; }
  .closing p { color: var(--text-secondary); line-height: 1.7; margin-bottom: var(--sp-6); }

  @media (max-width: 860px) {
    .paths { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .ways { grid-template-columns: 1fr; }
    .wall { flex-direction: column; gap: var(--sp-3); }
    .wall-issue { padding-top: 0; }
  }
</style>
