---
import BaseLayout from '../layouts/BaseLayout.astro'
import Playground from '../components/Playground.astro'

const compare = [
  { name: 'Types', sub: 'tsc', covers: 'Shape of data', misses: 'What the code actually does with it', tone: 'info' },
  { name: 'Tests', sub: 'vitest, jest', covers: 'Real behavior on the paths you run', misses: 'Inputs you didn’t run', tone: 'pending' },
  { name: 'LemmaScript', sub: 'contracts', covers: 'All inputs, behavior and all', misses: 'Nothing — that’s the point', tone: 'verified' },
]

const evidence = [
  { kind: 'Brownfield', metric: '4 CVEs', name: 'hono-lemmascript', desc: 'Security-critical middleware in a fork of Hono, hardened against four real CVEs — IP restriction, cookies, path traversal.', href: 'https://github.com/midspiral/hono-lemmascript' },
  { kind: 'Brownfield', metric: '11 functions', name: 'opencode-lemmascript', desc: 'A fork of opencode with its permission system locked down — eleven access-control functions guaranteed to honor their contracts.', href: 'https://github.com/midspiral/opencode-lemmascript' },
  { kind: 'Greenfield', metric: 'No overbooking', name: 'quota-lemmascript', desc: 'A booking app whose allocation logic is guaranteed incapable of overbooking — no matter the inputs.', href: 'https://github.com/midspiral/quota-lemmascript' },
]
---

<BaseLayout
  title="LemmaScript — TypeScript with contracts, for engineers and AI agents"
  description="LemmaScript adds contracts to TypeScript so your code is guaranteed correct — catching critical bugs before they reach production. Built for engineers and AI agents. No new language, no runtime cost."
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="container hero-full">
        <span class="hero-eyebrow"><span class="dot"></span> Built for engineers &amp; AI agents</span>
        <h1 class="hero-title">LemmaScript is TypeScript with syntax for <span class="pos-contracts">contracts</span>.</h1>
        <p class="hero-lede">
          Add a contract to any function and LemmaScript makes sure your code always honors it —
          catching critical bugs before they reach production. <strong>No new language. No runtime cost.</strong>
          Just code you can trust, for your team and your agents alike.
        </p>
        <div class="hero-actions">
          <a href="#playground" class="btn btn-primary">Try it live ↓</a>
          <a href="https://docs.lemmascript.com" target="_blank" rel="noopener" class="btn btn-secondary">Read the docs</a>
        </div>
        <div class="hero-trust">
          <span class="badge badge-info"><span class="bdot"></span>Zero runtime cost</span>
          <span class="badge badge-info"><span class="bdot"></span>Works on existing code</span>
          <span class="trust-note">// drop it into any TypeScript project</span>
        </div>
    </div>
  </section>

  <!-- ===================== EXAMPLE ===================== -->
  <section class="section example">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto">
        <span class="kicker">// a function that can’t be wrong</span>
        <h2>This compiles, type-checks, and is <em>guaranteed correct</em>.</h2>
      </div>
      <div class="example-art">
        <div class="codeblock">
          <div class="code-bar">
            <span class="dots"><i></i><i></i><i></i></span>
            <span class="code-file">quota.ts</span>
            <span class="badge badge-verified" style="margin-left:auto"><span class="bdot"></span>Guaranteed</span>
          </div>
          <pre class="code-body"><span class="ln">1</span><span class="t-anno">//@ requires</span> <span class="t-annokw">remaining &gt;= 0 &amp;&amp; cost &gt;= 0</span>
<span class="ln">2</span><span class="t-anno">//@ ensures</span>  <span class="t-annokw">\result &gt;= 0 &amp;&amp; \result &lt;= remaining</span>
<span class="ln">3</span><span class="t-kw">function</span> <span class="t-fn">charge</span>(remaining: <span class="t-kw">number</span>, cost: <span class="t-kw">number</span>): <span class="t-kw">number</span> &#123;
<span class="ln">4</span>  <span class="t-kw">if</span> (cost &gt; remaining) <span class="t-kw">return</span> <span class="t-num">0</span>; <span class="t-cmt">// no overbooking</span>
<span class="ln">5</span>  <span class="t-kw">return</span> remaining - cost;
<span class="ln">6</span>&#125;</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== THE PROBLEM ===================== -->
  <section class="section problem">
    <div class="container narrow">
      <span class="kicker">// the problem</span>
      <h2 class="problem-h">Generation got cheap. <span class="dim">Correctness didn’t.</span></h2>
      <p class="problem-p">
        Your team — and increasingly your agents — ship more code, faster, than ever. Your types line up.
        Your tests pass. For most code, that’s exactly enough.
      </p>
      <p class="problem-p">
        But some logic simply has to be right — billing, permissions, scheduling, access control. For that code,
        “the tests pass” isn’t the same as “this is correct, for <em>every</em> input” — and that gap is where the
        expensive bugs live.
      </p>
    </div>
  </section>

  <!-- ===================== THE SHIFT ===================== -->
  <section class="section section-alt shift">
    <div class="container narrow center">
      <span class="kicker">// the shift</span>
      <h2 class="shift-h">What if correctness were something you could <em>guarantee</em> — for every input, every time?</h2>
      <p class="shift-p">LemmaScript makes correctness a property of your code. Here, green doesn’t mean “it probably works.” It means <strong>guaranteed — for every input</strong>.</p>
      <div class="state-row">
        <span class="badge badge-verified"><span class="bdot"></span>Guaranteed</span>
        <span class="badge badge-pending"><span class="bdot"></span>Unchecked</span>
        <span class="badge badge-counter"><span class="bdot"></span>Bug found</span>
      </div>
    </div>
  </section>

  <!-- ===================== PLAYGROUND ===================== -->
  <div id="playground"></div>
  <Playground />

  <!-- ===================== THE DIFFERENCE ===================== -->
  <section class="section">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto">
        <span class="kicker">// the difference</span>
        <h2>Types check shape. Tests check behavior. LemmaScript guarantees the logic.</h2>
      </div>
      <div class="cmp-grid">
        {compare.map((c) => (
          <div class:list={['cmp', `cmp-${c.tone}`]}>
            <div class="cmp-top">
              <h3>{c.name}</h3>
              <span class="cmp-sub">{c.sub}</span>
            </div>
            <div class="cmp-row"><span class="cmp-k">✓ covers</span><p>{c.covers}</p></div>
            <div class="cmp-row"><span class="cmp-k miss">✗ leaves open</span><p>{c.misses}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== BUILT FOR AGENTS ===================== -->
  <section class="section section-alt">
    <div class="container two-col">
      <div>
        <span class="kicker">// built for AI agents</span>
        <h2>Your agents write code fast. LemmaScript makes sure it’s right.</h2>
        <p class="section-desc">
          AI agents generate plausible code in seconds — but “looks right” isn’t a guarantee.
          LemmaScript gives every function a contract it must honor and pinpoints the
          <strong>exact input that breaks it</strong>, so your agents ship code that’s correct —
          not just convincing — and fix it the moment it isn’t.
        </p>
        <a href="/how-it-works" class="link-arrow">See how it works →</a>
      </div>
      <div class="loop">
        <div class="loop-step"><span class="loop-n">1</span> agent writes a function &amp; its contract</div>
        <div class="loop-arrow">↓</div>
        <div class="loop-step"><span class="loop-n">2</span> LemmaScript checks it</div>
        <div class="loop-arrow">↓</div>
        <div class="loop-step counter"><span class="loop-n">3</span> ✗ bug found: <code>cost = -3</code></div>
        <div class="loop-arrow">↓</div>
        <div class="loop-step"><span class="loop-n">4</span> agent fixes it and re-runs</div>
        <div class="loop-arrow">↓</div>
        <div class="loop-step ok"><span class="loop-n">5</span> ✓ guaranteed correct</div>
      </div>
    </div>
  </section>

  <!-- ===================== EVIDENCE ===================== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">// in the wild</span>
        <h2>Not a toy. Real code, guaranteed correct.</h2>
        <p class="section-desc">LemmaScript has been put to work on production-grade software and greenfield builds — each one guaranteed correct, from the TypeScript you already write.</p>
      </div>
      <div class="ev-grid">
        {evidence.map((e) => (
          <a href={e.href} target="_blank" rel="noopener" class="card ev-card">
            <span class:list={['ev-kind', { brown: e.kind === 'Brownfield' }]}>{e.kind}</span>
            <div class="ev-metric">{e.metric}</div>
            <h3>{e.name}</h3>
            <p>{e.desc}</p>
            <span class="ev-link">View repository →</span>
          </a>
        ))}
      </div>
      <div class="center" style="margin-top:var(--sp-8)"><a href="/case-studies" class="link-arrow">See all case studies →</a></div>
    </div>
  </section>

  <!-- ===================== GET STARTED ===================== -->
  <section class="section section-alt">
    <div class="container two-col">
      <div>
        <span class="kicker">// get started</span>
        <h2>Add your first contract in minutes.</h2>
        <p class="section-desc">Add LemmaScript to a project, write a contract on a function, and you’re done. Greenfield or an existing codebase — adopt it exactly as far as you want.</p>
        <div class="hero-actions">
          <a href="https://docs.lemmascript.com" target="_blank" rel="noopener" class="btn btn-primary">Read the quickstart →</a>
          <a href="https://github.com/midspiral/LemmaScript" target="_blank" rel="noopener" class="btn btn-secondary">View on GitHub</a>
        </div>
      </div>
      <div class="codeblock">
        <div class="code-bar"><span class="dots"><i></i><i></i><i></i></span><span class="code-file">terminal</span></div>
        <pre class="code-body"><span class="t-cmt"># add LemmaScript to your project</span>
<span class="t-anno">$</span> npm install -D lemmascript

<span class="t-cmt"># check your code against its contracts</span>
<span class="t-anno">$</span> npx lemmascript check src/

<span class="t-kw">✓</span> charge   correct
<span class="t-kw">✓</span> refund   correct
<span class="t-cmt">2 / 2 correct · 1.2s</span></pre>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: var(--sp-24) var(--sp-16); }
  .hero-full { text-align: center; max-width: 1040px; margin-inline: auto; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: var(--sp-2); font-family: var(--font-mono);
    font-size: var(--fs-caption); letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);
    padding: 5px var(--sp-3); border-radius: var(--r-full); background: var(--state-verified-bg); border: 1px solid var(--accent-dim); margin-bottom: var(--sp-6); }
  .hero-eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .hero-title { font-size: clamp(2rem, 5vw, 3.1rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.12; margin-bottom: var(--sp-6); text-wrap: balance; }
  .hero-title .pos-contracts { color: var(--accent); }
  .hero-lede { font-size: var(--fs-body-lg); color: var(--text-secondary); max-width: 60ch; margin: 0 auto var(--sp-8); }
  .hero-lede strong { color: var(--text-primary); font-weight: 600; }
  .hero-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; justify-content: center; }
  .hero-trust { display: flex; align-items: center; gap: var(--sp-3); margin-top: var(--sp-8); flex-wrap: wrap; justify-content: center; }
  .trust-note { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-muted); }
  .example-art { max-width: 760px; margin-inline: auto; }

  /* ---------- shared narrow ---------- */
  .narrow { max-width: 64ch; }
  .center { text-align: center; }
  .center.narrow, .narrow.center { margin-inline: auto; }

  /* ---------- problem ---------- */
  .problem-h { font-size: var(--fs-h1); margin: var(--sp-3) 0 var(--sp-6); }
  .problem-h .dim { color: var(--text-muted); }
  .problem-p { font-size: var(--fs-body-lg); color: var(--text-secondary); margin-bottom: var(--sp-4); }
  .problem-p em { font-style: normal; color: var(--text-primary); }

  /* ---------- shift ---------- */
  .shift-h { font-size: var(--fs-h1); margin: var(--sp-3) auto var(--sp-4); max-width: 22ch; }
  .shift-h em { font-style: normal; color: var(--accent); }
  .shift-p { font-size: var(--fs-body-lg); color: var(--text-secondary); margin-inline: auto; max-width: 52ch; }
  .shift-p strong { color: var(--accent-bright); font-weight: 600; }
  .state-row { display: flex; gap: var(--sp-3); justify-content: center; margin-top: var(--sp-8); flex-wrap: wrap; }

  /* ---------- compare ---------- */
  .cmp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .cmp { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-lg); padding: var(--sp-6); }
  .cmp-verified { border-color: var(--accent-dim); box-shadow: var(--elev-glow); }
  .cmp-top { display: flex; align-items: baseline; gap: var(--sp-3); margin-bottom: var(--sp-4); padding-bottom: var(--sp-4); border-bottom: 1px solid var(--border-subtle); }
  .cmp-top h3 { font-size: var(--fs-h3); }
  .cmp-info .cmp-top h3 { color: var(--state-info); }
  .cmp-pending .cmp-top h3 { color: var(--state-pending); }
  .cmp-verified .cmp-top h3 { color: var(--accent); }
  .cmp-sub { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--text-faint); }
  .cmp-row { display: flex; gap: var(--sp-3); margin-bottom: var(--sp-3); }
  .cmp-k { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--accent); width: 72px; flex-shrink: 0; }
  .cmp-k.miss { color: var(--text-muted); }
  .cmp-row p { font-size: var(--fs-small); }

  /* ---------- two-col (agents, get started) ---------- */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-16); align-items: center; }
  .two-col h2 { margin: var(--sp-3) 0; }
  .two-col .section-desc strong { color: var(--accent-bright); font-weight: 600; }

  .loop { display: grid; gap: var(--sp-2); }
  .loop-step { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-4); font-family: var(--font-mono); font-size: var(--fs-small); color: var(--text-secondary); display: flex; align-items: center; gap: var(--sp-3); }
  .loop-step.counter { border-color: rgba(244,85,78,0.3); color: var(--state-counter); }
  .loop-step.counter code { color: var(--state-counter); }
  .loop-step.ok { border-color: var(--accent-dim); color: var(--accent); box-shadow: var(--elev-glow); }
  .loop-n { width: 20px; height: 20px; border-radius: 50%; background: var(--bg-overlay); color: var(--text-muted);
    display: grid; place-items: center; font-size: var(--fs-caption); flex-shrink: 0; }
  .loop-arrow { text-align: center; color: var(--text-faint); font-size: var(--fs-small); }

  /* ---------- evidence ---------- */
  .ev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .ev-card { display: flex; flex-direction: column; }
  .ev-kind { font-family: var(--font-mono); font-size: var(--fs-caption); text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); }
  .ev-kind.brown { color: var(--state-pending); }
  .ev-metric { font-family: var(--font-display); font-size: var(--fs-h2); font-weight: 700; color: var(--text-primary); letter-spacing: -0.02em; margin: var(--sp-2) 0; }
  .ev-card h3 { font-family: var(--font-mono); font-weight: 600; font-size: var(--fs-body); color: var(--accent-bright); margin-bottom: var(--sp-2); }
  .ev-card p { font-size: var(--fs-small); margin-bottom: var(--sp-4); }
  .ev-link { margin-top: auto; font-size: var(--fs-small); color: var(--text-muted); }
  .ev-card:hover .ev-link { color: var(--accent); }

  @media (max-width: 900px) {
    .two-col { grid-template-columns: 1fr; gap: var(--sp-12); }
    .cmp-grid, .ev-grid { grid-template-columns: 1fr; }
    .problem-h, .shift-h { font-size: 2rem; }
  }
</style>
