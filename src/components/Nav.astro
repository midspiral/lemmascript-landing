---
const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/annotations', label: 'Annotations' },
  { href: '/integrations', label: 'Integrations' },
  { href: '/case-studies', label: 'Case studies' },
  { href: '/about', label: 'About' },
  { href: 'https://docs.lemmascript.com', label: 'Docs', external: true },
]
---
<nav class="nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="LemmaScript home">
      <span class="nav-mark">LS</span>
      <span class="nav-name">Lemma<span>Script</span></span>
    </a>

    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
      ))}
    </div>

    <div class="nav-actions">
      <a href="https://github.com/midspiral/LemmaScript" target="_blank" rel="noopener" class="nav-ghost">GitHub</a>
      <a href="/how-it-works" class="nav-cta">Start verifying →</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(10, 14, 20, 0.72);
    backdrop-filter: blur(12px);
  }
  .nav-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--sp-3) var(--sp-6);
    display: flex;
    align-items: center;
    gap: var(--sp-8);
  }
  .nav-logo { display: flex; align-items: center; gap: var(--sp-3); }
  .nav-mark {
    width: 32px; height: 32px; border-radius: var(--r-md);
    display: grid; place-items: center;
    background: var(--state-verified-bg);
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    font-family: var(--font-mono); font-weight: 700; font-size: 13px;
    box-shadow: 0 0 16px var(--accent-glow);
  }
  .nav-name { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; }
  .nav-name span { color: var(--accent); }

  .nav-links { display: flex; gap: var(--sp-6); margin-left: var(--sp-4); }
  .nav-links a {
    font-size: var(--fs-small);
    color: var(--text-secondary);
  }
  .nav-links a:hover { color: var(--text-primary); }

  .nav-actions { margin-left: auto; display: flex; align-items: center; gap: var(--sp-4); }
  .nav-ghost { font-size: var(--fs-small); color: var(--text-secondary); }
  .nav-ghost:hover { color: var(--accent); }
  .nav-cta {
    font-size: var(--fs-small); font-weight: 600;
    padding: 8px var(--sp-4);
    border-radius: var(--r-md);
    background: var(--accent); color: var(--accent-ink);
    transition: background var(--dur-2) var(--ease), box-shadow var(--dur-2) var(--ease);
  }
  .nav-cta:hover { background: var(--accent-bright); box-shadow: 0 0 24px var(--accent-glow); }

  @media (max-width: 820px) {
    .nav-links { display: none; }
  }
</style>
