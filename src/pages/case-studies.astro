---
import BaseLayout from '../layouts/BaseLayout.astro'
import { byKind } from '../data/caseStudies'

const greenfield = byKind('Greenfield')
const brownfield = byKind('Brownfield')

const headlinePoints: Record<string, string[]> = {
  hono: ['4 real CVEs guaranteed closed', 'IP restriction · cookies · path traversal', 'Applied to an existing framework'],
  opencode: ['11 functions guaranteed', 'Agent permission / access control', 'A real Plan-Mode bypass closed'],
  quota: ['Guaranteed: never oversells', 'Local-first or on Cloudflare', 'Correct for every input'],
  quorum: ['Guaranteed: the count is exact', 'No accounts, no lock-in', 'Correct for every input'],
}
---

<BaseLayout
  title="Case studies — LemmaScript"
  description="Greenfield builds and brownfield forks of real projects, guaranteed correct with LemmaScript — from booking apps to production frameworks and CVEs."
>
  <header class="page-head">
    <div class="container">
      <span class="kicker">// case studies</span>
      <h1>Real code, <em>guaranteed</em> correct.</h1>
      <p class="lede">
        Each project below starts from ordinary TypeScript with contracts — and ends up guaranteed correct.
        Greenfield builds show LemmaScript from scratch; brownfield forks show it applied to existing,
        production-grade software.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="cs-head">
        <span class="badge badge-verified"><span class="bdot"></span>Greenfield</span>
        <p>New projects designed around correctness from the first line.</p>
      </div>
      <div class="cs-grid">
        {greenfield.map((c) => (
          <a href={`/case-studies/${c.slug}`} class="card cs-card">
            <span class="cs-kind">Greenfield</span>
            <h3>{c.repoName}</h3>
            <p>{c.cardDesc}</p>
            <ul class="cs-points">
              {headlinePoints[c.slug].map((p) => <li>{p}</li>)}
            </ul>
            <span class="cs-link">Read the case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cs-head">
        <span class="badge badge-pending"><span class="bdot"></span>Brownfield</span>
        <p>Correctness guarantees retrofitted onto existing, real-world codebases.</p>
      </div>
      <div class="cs-grid">
        {brownfield.map((c) => (
          <a href={`/case-studies/${c.slug}`} class="card cs-card">
            <span class="cs-kind brown">Brownfield</span>
            <h3>{c.repoName}</h3>
            <p>{c.cardDesc}</p>
            <ul class="cs-points">
              {headlinePoints[c.slug].map((p) => <li>{p}</li>)}
            </ul>
            <span class="cs-link">Read the case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center">
      <div class="cs-cta card">
        <span class="kicker">// have a codebase to lock down?</span>
        <h2>Bring LemmaScript to your own code.</h2>
        <p class="section-desc" style="margin:var(--sp-3) auto var(--sp-8);max-width:48ch">Start with one critical function or a whole module — greenfield or a fork.</p>
        <div class="cs-actions">
          <a href="/how-it-works" class="btn btn-primary">See how it works →</a>
          <a href="https://github.com/midspiral/LemmaScript" target="_blank" rel="noopener" class="btn btn-secondary">View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cs-head { display: flex; align-items: center; gap: var(--sp-4); margin-bottom: var(--sp-8); flex-wrap: wrap; }
  .cs-head p { font-size: var(--fs-small); color: var(--text-muted); }

  .cs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
  .cs-card { display: flex; flex-direction: column; }
  .cs-kind { font-family: var(--font-mono); font-size: var(--fs-caption); text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); }
  .cs-kind.brown { color: var(--state-pending); }
  .cs-card h3 { font-family: var(--font-mono); font-weight: 600; font-size: var(--fs-h3); margin: var(--sp-2) 0; }
  .cs-card p { font-size: var(--fs-small); }
  .cs-points { list-style: none; margin: var(--sp-4) 0; display: grid; gap: var(--sp-2); }
  .cs-points li { font-size: var(--fs-small); color: var(--text-secondary); padding-left: var(--sp-4); position: relative; }
  .cs-points li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-family: var(--font-mono); }
  .cs-link { margin-top: auto; font-size: var(--fs-small); color: var(--text-muted); }
  .cs-card:hover .cs-link { color: var(--accent); }

  .cs-cta { padding: var(--sp-16); box-shadow: var(--elev-glow); }
  .cs-cta h2 { font-size: var(--fs-h1); margin-top: var(--sp-3); }
  .cs-actions { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .cs-grid { grid-template-columns: 1fr; }
  }
</style>
