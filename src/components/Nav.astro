---
const product = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/features', label: 'Features' },
  { href: '/integrations', label: 'Integrations' },
  { href: '/annotations', label: 'Annotations' },
  { href: 'https://docs.lemmascript.com', label: 'Docs', external: true },
]

// Best-effort GitHub star count, fetched at build time.
let stars: number | null = null
try {
  const res = await fetch('https://api.github.com/repos/midspiral/LemmaScript', {
    headers: { Accept: 'application/vnd.github+json' },
  })
  if (res.ok) {
    const data = await res.json()
    stars = typeof data.stargazers_count === 'number' ? data.stargazers_count : null
  }
} catch {
  stars = null
}
const starLabel =
  stars == null ? null : stars >= 1000 ? (stars / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(stars)
---
<nav class="nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="LemmaScript home">
      <span class="nav-mark">LS</span>
      <span class="nav-name">Lemma<span>Script</span></span>
    </a>

    <div class="nav-links">
      <div class="nav-dd">
        <button class="nav-dd-btn" aria-haspopup="true" aria-expanded="false">Product <span class="nav-dd-caret"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.75 4.5 6 7.75 9.25 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button>
        <div class="nav-dd-menu">
          {product.map((l) => (
            <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
          ))}
        </div>
      </div>
      <a href="/case-studies">Case studies</a>
      <a href="https://docs.lemmascript.com" target="_blank" rel="noopener">Docs</a>
      <a href="/emira" class="nav-emira">Emira<span class="nav-soon">soon</span></a>
    </div>

    <div class="nav-actions">
      <a href="https://github.com/midspiral/LemmaScript" target="_blank" rel="noopener" class="nav-gh" aria-label="LemmaScript on GitHub">
        <svg class="nav-gh-mark" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        <span class="nav-gh-label">GitHub</span>
        {starLabel && (
          <span class="nav-gh-stars">
            <svg class="nav-gh-star" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 12.027 3.668 14.5l.96-4.92L1 6.236l4.96-.59L8 1l2.04 4.646 4.96.59-3.628 3.344.96 4.92z"/></svg>
            {starLabel}
          </span>
        )}
      </a>
      <a href="/install" class="nav-cta">Install</a>
    </div>

    <button class="nav-toggle" aria-label="Menu" aria-controls="nav-mobile" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav-mobile" id="nav-mobile">
    <a href="/how-it-works">How it works</a>
    <a href="/features">Features</a>
    <a href="/integrations">Integrations</a>
    <a href="/annotations">Annotations</a>
    <a href="/case-studies">Case studies</a>
    <a href="https://docs.lemmascript.com" target="_blank" rel="noopener">Docs</a>
    <a href="/emira" class="nav-m-emira">Emira <span class="nav-soon">soon</span></a>
    <div class="nav-mobile-foot">
      <a href="https://github.com/midspiral/LemmaScript" target="_blank" rel="noopener">GitHub{starLabel && <span class="nav-m-stars">· {starLabel} ★</span>}</a>
      <a href="/install" class="nav-cta">Install →</a>
    </div>
  </div>
</nav>

<script is:inline>
  // Reflect the hover/focus open state of the Product dropdown for screen readers.
  document.querySelectorAll('.nav-dd').forEach((dd) => {
    const btn = dd.querySelector('.nav-dd-btn')
    if (!btn) return
    const set = (v) => btn.setAttribute('aria-expanded', String(v))
    dd.addEventListener('mouseenter', () => set(true))
    dd.addEventListener('mouseleave', () => set(false))
    dd.addEventListener('focusin', () => set(true))
    dd.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget)) set(false) })
  })

  // Mobile menu toggle.
  const navToggle = document.querySelector('.nav-toggle')
  const navEl = document.querySelector('.nav')
  if (navToggle && navEl) {
    navToggle.addEventListener('click', () => {
      const open = navEl.classList.toggle('open')
      navToggle.setAttribute('aria-expanded', String(open))
    })
    navEl.querySelectorAll('.nav-mobile a').forEach((a) =>
      a.addEventListener('click', () => {
        navEl.classList.remove('open')
        navToggle.setAttribute('aria-expanded', 'false')
      })
    )
  }
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(10, 14, 20, 0.72);
    backdrop-filter: blur(12px);
  }
  .nav-inner {
    max-width: var(--container); margin-inline: auto;
    padding: var(--sp-3) var(--sp-6);
    display: flex; align-items: center; gap: var(--sp-8);
  }
  .nav-logo { display: flex; align-items: center; gap: var(--sp-3); }
  .nav-mark {
    width: 32px; height: 32px; border-radius: var(--r-md);
    display: grid; place-items: center;
    background: var(--state-verified-bg); border: 1px solid var(--accent-dim);
    color: var(--accent); font-family: var(--font-mono); font-weight: 700; font-size: 13px;
    box-shadow: 0 0 16px var(--accent-glow);
  }
  .nav-name { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; }
  .nav-name span { color: var(--accent); }

  .nav-links { display: flex; align-items: center; gap: var(--sp-6); margin-left: var(--sp-4); }
  .nav-links > a { font-size: var(--fs-small); color: var(--text-secondary); white-space: nowrap;
    display: inline-flex; align-items: center; gap: 6px; }
  .nav-links > a:hover { color: var(--text-primary); }

  /* ---- product dropdown ---- */
  .nav-dd { position: relative; }
  .nav-dd-btn {
    font-family: var(--font-body); font-size: var(--fs-small); color: var(--text-secondary);
    background: none; border: none; cursor: pointer; padding: 0;
    display: inline-flex; align-items: center; gap: 5px;
  }
  .nav-dd-caret { display: inline-flex; opacity: 0.55; transition: transform var(--dur-2) var(--ease), opacity var(--dur-2) var(--ease); }
  .nav-dd-caret svg { width: 12px; height: 12px; display: block; }
  .nav-dd:hover .nav-dd-btn, .nav-dd:focus-within .nav-dd-btn { color: var(--text-primary); }
  .nav-dd:hover .nav-dd-caret, .nav-dd:focus-within .nav-dd-caret { transform: rotate(180deg); opacity: 1; }
  /* invisible hover bridge so the menu doesn't drop on the gap */
  .nav-dd::after { content: ''; position: absolute; top: 100%; left: -8px; right: -8px; height: 14px; }
  .nav-dd-menu {
    position: absolute; top: calc(100% + 12px); left: 0; min-width: 210px;
    background: var(--bg-overlay); border: 1px solid var(--border); border-radius: var(--r-lg);
    padding: var(--sp-2); box-shadow: var(--elev-2); display: grid; gap: 2px;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease), visibility var(--dur-2);
  }
  .nav-dd:hover .nav-dd-menu, .nav-dd:focus-within .nav-dd-menu { opacity: 1; visibility: visible; transform: none; }
  .nav-dd-menu a { display: block; padding: 8px var(--sp-3); border-radius: var(--r-md);
    font-size: var(--fs-small); color: var(--text-secondary); white-space: nowrap; }
  .nav-dd-menu a:hover { background: var(--bg-surface); color: var(--text-primary); }

  /* ---- right actions ---- */
  .nav-actions { margin-left: auto; display: flex; align-items: center; gap: var(--sp-4); }
  .nav-gh { display: inline-flex; align-items: center; gap: 7px; font-size: var(--fs-small); color: var(--text-secondary);
    border: 1px solid var(--border); border-radius: var(--r-md); padding: 5px 10px;
    transition: border-color var(--dur-2) var(--ease), color var(--dur-2) var(--ease); }
  .nav-gh:hover { color: var(--text-primary); border-color: var(--border-strong); }
  .nav-gh-mark { width: 15px; height: 15px; }
  .nav-gh-label { line-height: 1; }
  .nav-gh-stars { display: inline-flex; align-items: center; gap: 4px; padding-left: 8px; margin-left: 1px;
    border-left: 1px solid var(--border); font-family: var(--font-mono); font-size: var(--fs-caption); line-height: 1; }
  .nav-gh-star { width: 12px; height: 12px; color: var(--state-pending); }
  .nav-cta { font-size: var(--fs-small); font-weight: 600; color: var(--accent); transition: color var(--dur-1) var(--ease); }
  .nav-cta:hover { color: var(--accent-bright); }
  .nav-emira { font-size: var(--fs-small); color: var(--text-secondary); display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .nav-emira:hover { color: var(--accent); }
  .nav-soon { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent); border: 1px solid var(--accent-dim); border-radius: var(--r-sm); padding: 1px 4px; }

  /* ---- mobile toggle + panel ---- */
  .nav-toggle { display: none; margin-left: var(--sp-3); width: 38px; height: 38px; flex-shrink: 0;
    border: 1px solid var(--border); border-radius: var(--r-md); background: var(--bg-surface); cursor: pointer;
    flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
  .nav-toggle span { width: 16px; height: 1.5px; background: var(--text-secondary); border-radius: 2px;
    transition: transform var(--dur-2) var(--ease), opacity var(--dur-2) var(--ease); }
  .nav.open .nav-toggle span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .nav.open .nav-toggle span:nth-child(2) { opacity: 0; }
  .nav.open .nav-toggle span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  .nav-mobile { display: none; flex-direction: column; padding: var(--sp-2) var(--sp-6) var(--sp-6);
    border-top: 1px solid var(--border-subtle); background: var(--bg-base); }
  .nav.open .nav-mobile { display: flex; }
  .nav-mobile > a { padding: var(--sp-3) 0; font-size: var(--fs-body); color: var(--text-secondary);
    border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; gap: var(--sp-2); }
  .nav-mobile > a:hover { color: var(--text-primary); }
  .nav-mobile-foot { display: flex; align-items: center; gap: var(--sp-6); padding-top: var(--sp-4); }
  .nav-m-stars { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--fs-caption); }

  @media (max-width: 860px) {
    .nav-links, .nav-gh { display: none; }
    .nav-toggle { display: flex; }
  }
  @media (min-width: 861px) {
    .nav-mobile { display: none !important; }
  }
</style>
